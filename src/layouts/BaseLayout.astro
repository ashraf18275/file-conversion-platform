---
const { title = "محوّل الملفات", description = "حوّل صورك داخل متصفحك دون رفعها إلى خادم." } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} /><meta name="color-scheme" content="light" /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" />
<title>{title} | محوّل الملفات</title>
<style>
:root{font-family:"IBM Plex Sans Arabic","Noto Sans Arabic",Tahoma,Arial,sans-serif;color:#172033;background:#f4f7fb;font-synthesis:none;text-rendering:optimizeLegibility;--ink:#172033;--muted:#64748b;--line:#e2e8f0;--primary:#3157c8;--primary-dark:#2446ad;--surface:#fff;--soft:#f8faff;--radius:20px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;line-height:1.75;letter-spacing:0}a{color:var(--primary);text-decoration:none}a:hover{text-decoration:underline}
a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #f4b740;outline-offset:3px}
.skip-link{position:absolute;top:-100px;right:1rem;padding:10px 14px;background:#fff;color:var(--ink);border:2px solid var(--primary);border-radius:10px;z-index:20}.skip-link:focus{top:1rem}
.wrap{width:min(1180px,92%);margin:auto}.top{background:rgba(255,255,255,.94);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:10;backdrop-filter:blur(14px)}.nav{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:15px 0;flex-wrap:wrap}.brand{display:flex;align-items:center;gap:11px;font-weight:850;color:var(--ink);font-size:1.15rem;letter-spacing:-.025em}.brand-mark{display:grid;place-items:center;width:40px;height:40px;border-radius:13px;background:linear-gradient(135deg,#3157c8,#6e8cff);color:#fff;box-shadow:0 7px 16px #3157c82b}.links{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.links a{padding:9px 13px;border-radius:10px;color:#46536a;font-weight:650}.links a:hover{background:#eef2ff;text-decoration:none;color:var(--primary)}
main{padding:36px 0 64px;min-height:75vh}.hero{padding:28px 0 24px}.eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--primary);font-weight:750;font-size:.9rem}.hero h1{font-size:clamp(2rem,4.8vw,3.35rem);line-height:1.25;letter-spacing:-.04em;margin:.35em 0}.lead{font-size:1.1rem;color:#58667b;max-width:760px;line-height:1.9}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px}.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:24px;box-shadow:0 10px 30px #17203308}.card h2,.card h3{margin-top:0;letter-spacing:-.02em}.button{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:48px;border:1px solid transparent;border-radius:13px;padding:12px 20px;background:var(--primary);color:#fff;font:inherit;font-weight:750;cursor:pointer;box-shadow:0 5px 12px #3157c81c;transition:background .15s,transform .15s,box-shadow .15s}.button:hover{background:var(--primary-dark);text-decoration:none;transform:translateY(-1px);box-shadow:0 8px 18px #3157c82b}.button.secondary{background:#eef2ff;color:#2948a8;border-color:#dbe4ff;box-shadow:none}.button.secondary:hover{background:#e0e8ff}.muted{color:var(--muted)}.notice{background:#effaf4;border:1px solid #ccebd8;padding:13px 16px;border-radius:13px;color:#24583a}.warn{background:#fff7e8;border:1px solid #f4d69d;padding:14px 16px;border-radius:13px;color:#7b4a0b}
footer{background:#fff;border-top:1px solid var(--line);padding:24px 0;color:var(--muted);font-size:.92rem}.field{display:grid;gap:8px;margin:16px 0}input,select{font:inherit;padding:12px 14px;border:1px solid #cbd5e1;border-radius:12px;background:white;width:100%;min-height:48px;color:var(--ink)}input[type=checkbox],input[type=radio]{width:20px;height:20px;min-height:20px;accent-color:var(--primary)}input[type=range]{padding:0;min-height:30px;accent-color:var(--primary)}input[type=file]{padding:9px;background:#fff;border:1px dashed #aab9d3;cursor:pointer}button:disabled{opacity:.55;cursor:not-allowed;transform:none;box-shadow:none}.preview{display:block;width:auto;max-width:100%;max-height:min(54vh,520px);object-fit:contain;border-radius:14px;margin:auto}.result{overflow-wrap:anywhere}.tool-panel{margin:16px 0;padding:20px;border:1px solid var(--line);border-radius:16px;background:#fff}.tool-panel summary{font-weight:800;cursor:pointer;color:#25365a}.fields-grid{grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px}.check-row{display:flex;align-items:center;gap:10px;margin:14px 0;cursor:pointer}.check-row input[type=checkbox]{flex:0 0 20px}.color-row{display:flex;align-items:center;gap:12px}.color-row input[type=color]{width:56px;height:48px;padding:4px;flex:0 0 56px}.button-row{display:flex;flex-wrap:wrap;gap:10px;margin:16px 0}.button-row .button{flex:0 0 auto}.hint{font-size:.92rem;margin:8px 0}.tool-panel small{line-height:1.7}input:disabled,select:disabled{background:#f1f5f9;color:#64748b}
@media(max-width:640px){.wrap{width:min(100% - 28px,1180px)}main{padding-top:22px}.nav{padding:11px 0}.links{width:100%;gap:4px}.links a{padding:8px 10px;font-size:.93rem}.hero{padding-top:20px}.card{padding:19px}.button{min-height:50px;padding:12px 16px}.button-row .button{flex:1 1 44%}}
</style>
</head>
<body>
<a class="skip-link" href="#main-content">انتقل إلى المحتوى</a>
<header class="top"><div class="wrap nav"><a class="brand" href={base}><span class="brand-mark" aria-hidden="true">↔</span><span>محوّل الملفات</span></a><nav class="links" aria-label="التنقل الرئيسي"><a href={`${base}convert/`}>تحويل الصور</a><a href={`${base}guide/`}>دليل الاستخدام</a><a href={`${base}privacy/`}>الخصوصية</a></nav></div></header>
<main id="main-content"><div class="wrap"><slot /></div></main><footer><div class="wrap">نسخة تجريبية قيد الاختبار — نعمل على أدوات عملية تحترم خصوصية ملفاتك.</div></footer>
</body></html>