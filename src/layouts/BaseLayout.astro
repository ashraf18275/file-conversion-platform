---
const { title = "محوّل الملفات", description = "حوّل صورك داخل متصفحك دون رفعها إلى خادم." } = Astro.props;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} /><meta name="color-scheme" content="light" />
<title>{title} | محوّل الملفات</title>
<style>
:root{font-family:"IBM Plex Sans Arabic","Noto Sans Arabic","Tahoma","Arial",sans-serif;color:#18243b;background:#f5f7fb;font-synthesis:none;text-rendering:optimizeLegibility;--ink:#18243b;--muted:#596981;--line:#dce3ef;--primary:#3558c9;--primary-dark:#2445ad;--surface:#fff;--soft:#f2f5fc;--radius:16px;--page-width:1160px;--focus:#f0b429;--control-height:46px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;line-height:1.7;letter-spacing:0;font-size:16px}a{color:var(--primary);text-decoration:none}a:hover{text-decoration:underline}
a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:3px solid var(--focus);outline-offset:3px}::selection{background:#dce6ff;color:var(--ink)}
.skip-link{position:absolute;top:-100px;right:1rem;padding:10px 14px;background:#fff;color:var(--ink);border:2px solid var(--primary);border-radius:10px;z-index:20}.skip-link:focus{top:1rem}
.wrap{width:min(var(--page-width),calc(100% - 40px));margin-inline:auto}.top{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:10;box-shadow:0 2px 10px #18243b08}.nav{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:10px 0;flex-wrap:wrap;min-height:64px}.brand{display:flex;align-items:center;gap:10px;font-weight:850;color:var(--ink);font-size:1.08rem;white-space:nowrap}.brand-mark{display:grid;place-items:center;width:38px;height:38px;border-radius:11px;background:var(--primary);color:#fff;font-size:1.2rem}.links{display:flex;align-items:center;gap:4px;flex-wrap:wrap}.links a{display:inline-flex;align-items:center;min-height:44px;padding:8px 12px;border-radius:9px;color:#35445f;font-weight:700;font-size:.95rem;transition:background .15s,color .15s}.links a:hover,.links a:focus-visible,.links a[aria-current="page"]{background:#eaf0ff;text-decoration:none;color:var(--primary)}
main{padding:24px 0 56px;min-height:78vh}.hero{padding:18px 0 20px}.eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--primary);font-weight:750;font-size:.9rem}.hero h1{font-size:clamp(1.9rem,3.4vw,2.7rem);line-height:1.3;letter-spacing:-.025em;margin:.3em 0}.lead{font-size:1.03rem;color:#4f5f78;max-width:700px;line-height:1.8}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px}.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:22px;box-shadow:0 4px 16px #18243b06}.card h2,.card h3{margin-top:0;letter-spacing:-.015em}.button{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;border:1px solid transparent;border-radius:10px;padding:11px 17px;background:var(--primary);color:#fff;font:inherit;font-weight:750;cursor:pointer;box-shadow:0 3px 8px #3558c91c;transition:background .15s,transform .15s,box-shadow .15s}.button:hover{background:var(--primary-dark);text-decoration:none;transform:translateY(-1px);box-shadow:0 6px 14px #3558c926}.button.secondary{background:#eef2fb;color:#2948a8;border-color:#d8e1f5;box-shadow:none}.button.secondary:hover{background:#e2eaff}.muted{color:var(--muted)}.notice{background:#edf8f1;border:1px solid #c6e8d2;padding:12px 15px;border-radius:11px;color:#24583a}.warn{background:#fff7e8;border:1px solid #f4d69d;padding:12px 15px;border-radius:11px;color:#7b4a0b}
footer{background:#fff;border-top:1px solid var(--line);padding:24px 0;color:var(--muted);font-size:.9rem}.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}.footer-inner p{margin:0}.footer-links{display:flex;flex-wrap:wrap;gap:8px 14px}.footer-links a{color:#465670;font-weight:650}.footer-links a:hover{color:var(--primary)}.field{display:grid;gap:7px;margin:14px 0}input,select,textarea{font:inherit;padding:11px 13px;border:1px solid #c8d3e4;border-radius:10px;background:#fff;width:100%;min-height:var(--control-height);color:var(--ink)}textarea{resize:vertical;line-height:1.7}input[type=checkbox],input[type=radio]{width:19px;height:19px;min-height:19px;accent-color:var(--primary)}input[type=range]{padding:0;min-height:28px;accent-color:var(--primary)}input[type=file]{padding:9px;background:#fff;border:1px dashed #aab9d3;cursor:pointer}button:disabled{opacity:.55;cursor:not-allowed;transform:none;box-shadow:none}.preview{display:block;width:auto;max-width:100%;max-height:min(48vh,440px);object-fit:contain;border-radius:12px;margin:auto}.result{overflow-wrap:anywhere}.tool-panel{margin:12px 0;padding:18px;border:1px solid var(--line);border-radius:13px;background:#fff}.tool-panel summary{font-weight:800;cursor:pointer;color:#25365a}.fields-grid{grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}.check-row{display:flex;align-items:center;gap:10px;margin:12px 0;cursor:pointer}.check-row input[type=checkbox]{flex:0 0 19px}.color-row{display:flex;align-items:center;gap:12px}.color-row input[type=color]{width:56px;height:46px;padding:4px;flex:0 0 56px}.button-row{display:flex;flex-wrap:wrap;gap:9px;margin:14px 0}.button-row .button{flex:0 0 auto}.hint{font-size:.9rem;margin:8px 0}.tool-panel small{line-height:1.65}input:disabled,select:disabled{background:#f1f4f8;color:#64748b}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}\n@media(max-width:640px){.wrap{width:calc(100% - 24px)}main{padding-top:16px}.nav{padding:9px 0;gap:7px}.links{width:100%;flex-wrap:nowrap;gap:5px;overflow-x:auto;overflow-y:hidden;padding:2px 1px 6px;scrollbar-width:thin;scrollbar-color:#cbd5e1 transparent;overscroll-behavior-inline:contain;-webkit-overflow-scrolling:touch}.links a{flex:0 0 auto;white-space:nowrap;padding:8px 10px;font-size:.9rem}.hero{padding-top:14px}.card{padding:16px}.button{min-height:48px;padding:11px 14px}.button-row .button{flex:1 1 44%}}
</style>
</head>
<body>
<a class="skip-link" href="#main-content">انتقل إلى المحتوى</a>
<header class="top"><div class="wrap nav"><a class="brand" href={base}><span class="brand-mark" aria-hidden="true">↔</span><span>محوّل الملفات</span></a><nav class="links" aria-label="التنقل الرئيسي"><a href={base} aria-current={currentPath === base ? "page" : undefined}>جميع الأدوات</a><a href={`${base}convert/`} aria-current={currentPath === `${base}convert/` ? "page" : undefined}>محرر الصور</a><a href={`${base}guide/`} aria-current={currentPath === `${base}guide/` ? "page" : undefined}>دليل الاستخدام</a><a href={`${base}privacy/`} aria-current={currentPath === `${base}privacy/` ? "page" : undefined}>الخصوصية</a></nav></div></header>
<main id="main-content"><div class="wrap"><slot /></div></main><footer><div class="wrap footer-inner"><p>نسخة تجريبية قيد التطوير — نختبر الأدوات قبل إعلان جاهزيتها.</p><nav class="footer-links" aria-label="روابط التذييل"><a href={base}>جميع الأدوات</a><a href={`${base}convert/`}>محرر الصور</a><a href={`${base}guide/`}>دليل الاستخدام</a><a href={`${base}privacy/`}>الخصوصية</a></nav></div></footer>
</body></html>