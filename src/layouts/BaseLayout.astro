---
const { title = "محوّل الملفات", description = "حوّل صورك داخل متصفحك دون رفعها إلى خادم." } = Astro.props;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} /><meta name="color-scheme" content="light" />
<title>{title} | محوّل الملفات</title>
<style>
:root{font-family:"Segoe UI",Tahoma,Arial,sans-serif;color:#172033;background:#f6f7fb;font-synthesis:none;text-rendering:optimizeLegibility;--ink:#172033;--muted:#64748b;--line:#e2e7f0;--primary:#4655cf;--primary-dark:#3443b7;--surface:#fff;--soft:#f8faff;--radius:22px;--page-width:1240px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;line-height:1.75;letter-spacing:0}a{color:var(--primary);text-decoration:none}a:hover{text-decoration:underline}
a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #f4b740;outline-offset:3px}
.skip-link{position:absolute;top:-100px;right:1rem;padding:10px 14px;background:#fff;color:var(--ink);border:2px solid var(--primary);border-radius:10px;z-index:20}.skip-link:focus{top:1rem}
.wrap{width:min(var(--page-width),calc(100% - 56px));margin-inline:auto}.top{background:rgba(255,255,255,.9);border-bottom:1px solid #e5e9f1;position:sticky;top:0;z-index:10;backdrop-filter:blur(18px);box-shadow:0 5px 22px #17203305}.nav{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:13px 0;flex-wrap:wrap;min-height:72px}.brand{display:flex;align-items:center;gap:11px;font-weight:850;color:var(--ink);font-size:1.12rem;letter-spacing:-.025em;white-space:nowrap}.brand-mark{display:grid;place-items:center;width:42px;height:42px;border-radius:14px;background:linear-gradient(145deg,#3e4ec6,#7985f5);color:#fff;box-shadow:0 8px 20px #4655cf35;font-size:1.25rem}.links{display:flex;align-items:center;gap:5px;flex-wrap:wrap}.links a{padding:10px 14px;border-radius:12px;color:#4b5870;font-weight:650;font-size:.94rem;transition:background .15s,color .15s}.links a:hover,.links a:focus-visible,.links a[aria-current="page"]{background:#eef0ff;text-decoration:none;color:var(--primary)}
main{padding:34px 0 76px;min-height:78vh}.hero{padding:28px 0 24px}.eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--primary);font-weight:750;font-size:.9rem}.hero h1{font-size:clamp(2rem,4.8vw,3.35rem);line-height:1.25;letter-spacing:-.04em;margin:.35em 0}.lead{font-size:1.1rem;color:#58667b;max-width:760px;line-height:1.9}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px}.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:clamp(18px,3vw,30px);box-shadow:0 14px 42px #17203308}.card h2,.card h3{margin-top:0;letter-spacing:-.02em}.button{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:48px;border:1px solid transparent;border-radius:13px;padding:12px 20px;background:var(--primary);color:#fff;font:inherit;font-weight:750;cursor:pointer;box-shadow:0 5px 12px #3157c81c;transition:background .15s,transform .15s,box-shadow .15s}.button:hover{background:var(--primary-dark);text-decoration:none;transform:translateY(-1px);box-shadow:0 8px 18px #3157c82b}.button.secondary{background:#eef2ff;color:#2948a8;border-color:#dbe4ff;box-shadow:none}.button.secondary:hover{background:#e0e8ff}.muted{color:var(--muted)}.notice{background:#effaf4;border:1px solid #ccebd8;padding:13px 16px;border-radius:13px;color:#24583a}.warn{background:#fff7e8;border:1px solid #f4d69d;padding:14px 16px;border-radius:13px;color:#7b4a0b}
footer{background:#fff;border-top:1px solid var(--line);padding:30px 0;color:var(--muted);font-size:.9rem}.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}.footer-inner p{margin:0}.footer-links{display:flex;flex-wrap:wrap;gap:8px 16px}.footer-links a{color:#58667b;font-weight:650}.footer-links a:hover{color:var(--primary)}.field{display:grid;gap:8px;margin:16px 0}input,select{font:inherit;padding:12px 14px;border:1px solid #cbd5e1;border-radius:12px;background:white;width:100%;min-height:48px;color:var(--ink)}input[type=checkbox],input[type=radio]{width:20px;height:20px;min-height:20px;accent-color:var(--primary)}input[type=range]{padding:0;min-height:30px;accent-color:var(--primary)}input[type=file]{padding:9px;background:#fff;border:1px dashed #aab9d3;cursor:pointer}button:disabled{opacity:.55;cursor:not-allowed;transform:none;box-shadow:none}.preview{display:block;width:auto;max-width:100%;max-height:min(54vh,520px);object-fit:contain;border-radius:14px;margin:auto}.result{overflow-wrap:anywhere}.tool-panel{margin:16px 0;padding:20px;border:1px solid var(--line);border-radius:16px;background:#fff}.tool-panel summary{font-weight:800;cursor:pointer;color:#25365a}.fields-grid{grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px}.check-row{display:flex;align-items:center;gap:10px;margin:14px 0;cursor:pointer}.check-row input[type=checkbox]{flex:0 0 20px}.color-row{display:flex;align-items:center;gap:12px}.color-row input[type=color]{width:56px;height:48px;padding:4px;flex:0 0 56px}.button-row{display:flex;flex-wrap:wrap;gap:10px;margin:16px 0}.button-row .button{flex:0 0 auto}.hint{font-size:.92rem;margin:8px 0}.tool-panel small{line-height:1.7}input:disabled,select:disabled{background:#f1f5f9;color:#64748b}
@media(max-width:640px){.wrap{width:calc(100% - 28px)}main{padding-top:22px}.nav{padding:11px 0;gap:8px}.links{width:100%;flex-wrap:nowrap;gap:6px;overflow-x:auto;overflow-y:hidden;padding:2px 1px 7px;scrollbar-width:thin;scrollbar-color:#cbd5e1 transparent;overscroll-behavior-inline:contain;-webkit-overflow-scrolling:touch}.links a{flex:0 0 auto;white-space:nowrap;padding:8px 12px;font-size:.93rem}.hero{padding-top:20px}.card{padding:19px}.button{min-height:50px;padding:12px 16px}.button-row .button{flex:1 1 44%}}
</style>
</head>
<body>
<a class="skip-link" href="#main-content">انتقل إلى المحتوى</a>
<header class="top"><div class="wrap nav"><a class="brand" href={base}><span class="brand-mark" aria-hidden="true">↔</span><span>محوّل الملفات</span></a><nav class="links" aria-label="التنقل الرئيسي"><a href={base} aria-current={currentPath === base ? "page" : undefined}>جميع الأدوات</a><a href={`${base}convert/`} aria-current={currentPath === `${base}convert/` ? "page" : undefined}>محرر الصور</a><a href={`${base}guide/`} aria-current={currentPath === `${base}guide/` ? "page" : undefined}>دليل الاستخدام</a><a href={`${base}privacy/`} aria-current={currentPath === `${base}privacy/` ? "page" : undefined}>الخصوصية</a></nav></div></header>
<main id="main-content"><div class="wrap"><slot /></div></main><footer><div class="wrap footer-inner"><p>نسخة تجريبية قيد التطوير — نختبر الأدوات قبل إعلان جاهزيتها.</p><nav class="footer-links" aria-label="روابط التذييل"><a href={base}>جميع الأدوات</a><a href={`${base}convert/`}>محرر الصور</a><a href={`${base}guide/`}>دليل الاستخدام</a><a href={`${base}privacy/`}>الخصوصية</a></nav></div></footer>
</body></html>