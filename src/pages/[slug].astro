---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrowserImageConverter from "../components/BrowserImageConverter.astro";
import { toolPages } from "../data/tool-catalog";

export function getStaticPaths() {
  return toolPages.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

const { tool } = Astro.props;
const base = import.meta.env.BASE_URL;
const supportedToolSlugs = new Set([
  "webp-to-jpg",
  "webp-to-png",
  "png-to-jpg",
  "jpg-to-png",
  "png-to-webp",
  "jpg-to-webp",
]);
const hasWorkingConverter = supportedToolSlugs.has(tool.slug);
---
<BaseLayout title={tool.title} description={tool.description}>
  <nav class="breadcrumbs" aria-label="مسار التنقل">
    <a href={base}>الرئيسية</a><span aria-hidden="true">/</span>
    <a href={`${base}${tool.category === "pdf" ? "pdf-tools/" : "image-converter/"}`}>{tool.category === "pdf" ? "أدوات PDF" : "تحويل الصور"}</a>
    <span aria-hidden="true">/</span><span aria-current="page">{tool.title}</span>
  </nav>
  <article class="tool-page">
    <span class="eyebrow">{tool.category === "pdf" ? "أدوات المستندات" : "أدوات الصور"}</span>
    <h1>{tool.title}</h1>
    <p class="lead">{tool.intro}</p>
    {hasWorkingConverter && <BrowserImageConverter tool={tool} />}
    <section class="format-summary" aria-label="ملخص المهمة">
      <div><span>الملف المطلوب</span><strong>{tool.inputLabel}</strong></div>
      <span class="arrow" aria-hidden="true">←</span>
      <div><span>النتيجة المقصودة</span><strong>{tool.outputLabel}</strong></div>
    </section>
    <section class="details"><h2>ما الذي ينبغي معرفته؟</h2><p>{tool.details}</p></section>
    {!hasWorkingConverter && <aside class="availability" role="note"><strong>المعالجة غير مفعّلة لهذه المهمة حتى الآن.</strong><p>{tool.note} لن نطلب منك اختيار ملف قبل تفعيل المعالجة واختبارها.</p></aside>}
    <a class="button secondary" href={base}>العودة إلى الصفحة الرئيسية</a>
  </article>
</BaseLayout>
<style>
.breadcrumbs{display:flex;flex-wrap:wrap;gap:9px;align-items:center;color:#718096;font-size:.9rem;margin:0 0 18px}.breadcrumbs a{font-weight:700}.tool-page{max-width:920px;margin:0 auto 38px;padding:clamp(22px,4vw,42px);background:#fff;border:1px solid var(--line);border-radius:var(--radius);box-shadow:0 4px 16px #18243b06}.tool-page h1{font-size:clamp(1.9rem,4vw,2.75rem);line-height:1.3;margin:8px 0}.tool-page>.lead{max-width:680px;margin:0 0 22px}.format-summary{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:19px;border:1px solid var(--line);border-radius:13px;background:var(--soft)}.format-summary div{display:grid;gap:4px}.format-summary div span{font-size:.82rem;color:var(--muted)}.format-summary strong{font-size:.98rem}.arrow{color:var(--primary);font-size:1.4rem}.details{margin:23px 0}.details h2{font-size:1.2rem;margin:0 0 5px}.details p{margin:0;color:var(--muted);line-height:1.85}.availability{margin:20px 0 24px;padding:15px 17px;border:1px solid #f1d6a5;border-radius:12px;background:#fff8ea;color:#71480d}.availability p{margin:4px 0 0;line-height:1.75}.tool-page>.button{min-height:46px}@media(max-width:540px){.format-summary{align-items:flex-start;flex-direction:column}.arrow{transform:rotate(-90deg);align-self:center}.tool-page{padding:20px}}
</style>
