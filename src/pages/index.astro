.hero-copy{max-width:650px}.status-dot{width:8px;height:8px;border-radius:50%;background:#1b9b73;display:inline-block;box-shadow:0 0 0 4px #1b9b7318}.home-hero .eyebrow{padding:8px 12px;border:1px solid #dce4fa;border-radius:999px;background:#fff;color:#4058a5;font-size:.84rem}
.home-hero h1{font-size:clamp(2.65rem,5.3vw,4.65rem);line-height:1.18;margin:22px 0 18px;letter-spacing:-.055em;color:#111b33;font-weight:800}.home-hero h1 span{color:#4b55d7}.home-hero .lead{font-size:clamp(1rem,1.5vw,1.12rem);line-height:1.95;max-width:600px;color:#5a6680}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.hero-actions .button{min-height:54px;padding-inline:23px;border-radius:15px}.hero-actions .button.secondary{background:#fff;border-color:#dce3f1;color:#34415c}.trust-line{display:flex;align-items:center;gap:9px;flex-wrap:wrap;color:#64718a;font-size:.86rem;margin-top:23px}.trust-line>span:first-child{display:grid;place-items:center;width:22px;height:22px;border-radius:50%;background:#dff6e9;color:#16804a;font-weight:800}.trust-separator{color:#b2bdcc}
.hero-art{position:relative;min-height:340px;display:grid;place-items:center;isolation:isolate}.art-glow{position:absolute;width:min(300px,85%);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,#dce5ff 0%,#eaf0ff 57%,#f4f6ff 72%);z-index:-1}.file-card{position:absolute;background:#fff;border:1px solid #e0e6f2;border-radius:23px;box-shadow:0 28px 65px #263a6518}.file-card-back{width:205px;height:235px;top:28px;right:3%;transform:rotate(8deg);padding:24px;opacity:.94}.file-line{display:block;height:8px;width:100%;background:#edf1f7;border-radius:9px;margin-top:17px}.file-line.short{width:60%;margin-top:10px}.file-card-front{width:min(270px,86%);padding:17px;left:3%;top:66px;transform:rotate(-3deg)}.photo-sample{height:150px;position:relative;overflow:hidden;border-radius:16px;background:linear-gradient(180deg,#c7e5ff,#f6e8d8 70%,#d5eadc)}.sun{position:absolute;top:22px;left:32px;width:35px;height:35px;border-radius:50%;background:#ffd477}.mountain{position:absolute;bottom:-20px;width:190px;height:130px;transform:rotate(45deg);border-radius:15px}.mountain-one{left:-16px;background:#78a6a0}.mountain-two{right:-65px;bottom:-48px;background:#4f777b}.art-file-meta{display:flex;flex-direction:column;margin-top:13px;font-size:.9rem}.art-file-meta span{color:#64748b;font-size:.8rem}.convert-arrow{position:absolute;left:-22px;top:112px;display:grid;place-items:center;width:46px;height:46px;border:4px solid #fff;border-radius:16px;background:#4b55d7;color:#fff;font-size:1.5rem;box-shadow:0 10px 24px #4b55d74a}.file-icon{position:absolute;top:18px;left:18px;border-radius:9px;padding:6px 9px;font-size:.7rem;font-weight:850;letter-spacing:.04em}.file-png{background:#e8efff;color:#3157c8}.file-webp{position:static;display:inline-block;margin-top:13px;background:#e2f7ec;color:#16804a;align-self:flex-start}.floating-check{position:absolute;bottom:18px;right:7%;width:51px;height:51px;display:grid;place-items:center;border-radius:50%;background:#e2f7ec;color:#16804a;border:5px solid #f4f6ff;font-size:1.3rem;font-weight:900;box-shadow:0 10px 24px #1b9b731c}
.section-heading{display:flex;align-items:end;justify-content:space-between;gap:18px;margin:20px 0 24px}.section-heading h2,.home-bottom h2{margin:6px 0;font-size:clamp(1.55rem,2.8vw,2rem);letter-spacing:-.035em;color:#18233b}.section-heading p{margin:0}.text-link{font-weight:800;white-space:nowrap}.tool-filters{display:grid;grid-template-columns:minmax(240px,.75fr) 2fr;gap:14px;align-items:center;margin:0 0 22px;padding:16px;border:1px solid #e0e6f0;border-radius:20px;background:#fff;box-shadow:0 8px 26px #1b2b4b06}.tool-search{display:flex;align-items:center;gap:10px;min-height:52px;padding:0 15px;border:1px solid #dce3ee;border-radius:14px;background:#f8faff;color:#6b7890}.tool-search span{font-size:1.5rem}.tool-search input{width:100%;min-width:0;border:0;outline:0;background:transparent;color:#17233d;font:inherit;box-shadow:none}.category-filters{display:flex;flex-wrap:wrap;gap:8px}.category-filter{min-height:41px;padding:7px 13px;border:1px solid #e0e6f0;border-radius:11px;background:#fff;color:#52617a;font:inherit;font-size:.86rem;font-weight:700;cursor:pointer;transition:all .15s}.category-filter:hover{border-color:#b8c5f4;color:#3e4fc0}.category-filter.active{background:#e9edff;border-color:#cbd4ff;color:#3948b8}.tool-results{grid-column:1/-1;margin:0;color:#748197;font-size:.82rem}.tool-card[hidden]{display:none}.tool-icon svg{width:25px;height:25px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.tool-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.tool-card{position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:13px;min-height:250px;padding:23px;background:#fff;border:1px solid #e1e6ef;border-radius:21px;color:#172033;transition:transform .18s,border-color .18s,box-shadow .18s}.tool-card:hover{transform:translateY(-4px);border-color:#c2ccfa;box-shadow:0 18px 38px #17203310;text-decoration:none}.tool-card:focus-visible{outline:3px solid #7887ef;outline-offset:3px}.tool-card.featured{border-color:#c5cefb;background:linear-gradient(145deg,#fff,#f7f8ff)}.tool-icon{width:52px;height:52px;display:grid;place-items:center;border-radius:16px;font-size:1.8rem;font-weight:700}.icon-blue{background:#e8efff;color:#3157c8}.icon-violet{background:#f0eaff;color:#7847c7}.icon-green{background:#e5f8ed;color:#16804a}.icon-orange{background:#fff0df;color:#b76b13}.tool-card-title{font-size:1.06rem;font-weight:850;letter-spacing:-.015em}.tool-card-description{font-size:.9rem;line-height:1.85;color:#66728a}.tool-card-action{margin-top:auto;color:#4453cb;font-weight:800;font-size:.9rem}.tool-tag{position:absolute;top:17px;left:17px;padding:5px 9px;border-radius:9px;background:#e8efff;color:#3157c8;font-size:.68rem;font-weight:800}.privacy-strip{display:flex;align-items:center;gap:18px;margin-top:32px;padding:25px 27px;border:1px solid #cce9da;border-radius:22px;background:linear-gradient(110deg,#f0fbf5,#f8fffb)}.privacy-icon{flex:0 0 50px;width:50px;height:50px;display:grid;place-items:center;background:#dff5e7;border-radius:16px;color:#18794e;font-size:1.65rem}.privacy-strip h2{font-size:1.12rem;margin:0 0 3px}.privacy-strip p{margin:0;color:#52715f;font-size:.9rem}.privacy-strip>a{margin-right:auto;white-space:nowrap;font-weight:750;font-size:.88rem}.home-bottom{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:48px 0 12px}.home-bottom p{margin:5px 0}
