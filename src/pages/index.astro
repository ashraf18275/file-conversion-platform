---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="تحويل الصور وضغطها وتغيير حجمها مجانًا أونلاين" description="أدوات صور مجانية أونلاين: تحويل JPG إلى PNG وWebP، ضغط الصور، تغيير حجم الصورة واقتصاصها وتدويرها مباشرة من المتصفح.">


<main id="main-content" class="wrap">
<h1 class="page-title">أدوات تحويل الصور</h1>
<aside class="ad-slot ad-slot-top" aria-label="مساحة إعلانية"><span class="ad-label">إعلان</span><span class="ad-placeholder">مساحة إعلانية متاحة مستقبلًا</span></aside>
<div class="tool-filters" aria-label="البحث وتصنيف الأدوات">
  <label class="tool-search"><span aria-hidden="true">⌕</span><input id="tool-search" type="search" placeholder="ابحث باسم الأداة أو الصيغة…" aria-label="ابحث باسم الأداة أو الصيغة" /></label>
  <div class="category-filters" role="group" aria-label="تصنيف الأدوات">
    <button type="button" class="category-filter active" data-category="all" aria-pressed="true">الكل</button>
    <button type="button" class="category-filter" data-category="convert" aria-pressed="false">تحويل الصيغ</button>
    <button type="button" class="category-filter" data-category="edit" aria-pressed="false">تحرير الصور</button>
    <button type="button" class="category-filter" data-category="compress" aria-pressed="false">ضغط الصور</button>
    <button type="button" class="category-filter" data-category="advanced" aria-pressed="false">الأبعاد المتقدمة</button>

  </div>

</div>
<p id="tool-results" class="tool-results" aria-live="polite">5 أدوات في الدليل</p>
<section class="tool-grid" id="tool-grid" aria-label="أدوات المنصة">
  <a class="tool-card featured" data-category="convert" data-search="تحويل صيغ الصور png jpeg jpg webp bmp تحويل صيغة" href={`${base}convert/#format-panel`}><span class="tool-icon icon-blue" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h15m-4-4 4 4-4 4M20 17H5m4-4-4 4 4 4"/></svg></span><span class="tool-card-title">تحويل صيغ الصور</span><span class="tool-card-description">حوّل إلى PNG أو JPEG أو WebP أو BMP، مع توضيح خصائص كل صيغة.</span><span class="tool-card-action">ابدأ التحويل <span aria-hidden="true">←</span></span><span class="tool-tag">الأداة الأساسية</span></a>
  <a class="tool-card" data-category="advanced" data-search="اقتصاص قص تغيير الأبعاد المقاس الحجم crop resize" href={`${base}convert/#crop-panel`}><span class="tool-icon icon-violet" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4M8 8h8v8H8z"/></svg></span><span class="tool-card-title">اقتصاص وتغيير الأبعاد</span><span class="tool-card-description">حدّد الجزء المطلوب، واضبط مقاس الصورة قبل التصدير.</span><span class="tool-card-action">فتح المحرر <span aria-hidden="true">←</span></span></a>
  <a class="tool-card" data-category="compress" data-search="ضغط الصور تقليل الحجم الجودة jpeg webp compress" href={`${base}convert/#quality`}><span class="tool-icon icon-green" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h12M4 17h8"/><circle cx="18" cy="12" r="2"/><circle cx="14" cy="17" r="2"/></svg></span><span class="tool-card-title">ضغط الصور</span><span class="tool-card-description">اضبط جودة JPEG وWebP وقارن حجم الملف الناتج بالأصل.</span><span class="tool-card-action">تقليل الحجم <span aria-hidden="true">←</span></span></a>
  <a class="tool-card" data-category="edit" data-search="تحسين الصور سطوع إضاءة تباين ألوان تشبع تحسين enhance photo" href={`${base}convert/#panel-enhance`}><span class="tool-icon icon-violet" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1m0-12.8-2.1 2.1m-8.6 8.6-2.1 2.1"/><circle cx="12" cy="12" r="4.2"/></svg></span><span class="tool-card-title">تحسين الصور</span><span class="tool-card-description">اضبط السطوع والتباين وتشبع الألوان، وراجع النتيجة قبل التنزيل.</span><span class="tool-card-action">تحسين الصورة <span aria-hidden="true">←</span></span></a>
  <a class="tool-card" data-category="edit" data-search="تدوير الصور قلب أفقي رأسي rotate flip" href={`${base}convert/#panel-transform`}><span class="tool-icon icon-blue" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 7v5h-5M4 17v-5h5M5.6 9A7 7 0 0 1 18 6l2 6M4 12l2 6a7 7 0 0 0 12.4-3"/></svg></span><span class="tool-card-title">التدوير والقلب</span><span class="tool-card-description">دوّر الصورة أو اقلبها أفقيًا ورأسيًا قبل التصدير.</span><span class="tool-card-action">فتح أدوات التدوير <span aria-hidden="true">←</span></span></a>
</section>
<aside class="ad-slot ad-slot-bottom" aria-label="مساحة إعلانية"><span class="ad-label">إعلان</span><span class="ad-placeholder">مساحة إعلانية متاحة مستقبلًا</span></aside>
  <section class="privacy-strip"><span class="privacy-icon" aria-hidden="true">⌑</span><div><h2>اعرف كيف تُعالج ملفاتك</h2><p>معالجة الصور في المحرر تتم داخل المتصفح. راجع طلبات الشبكة في أدوات المطور للتحقق من عدم إرسال ملف الصورة إلى خادم.</p></div><a href={`${base}privacy/`}>اقرأ سياسة الخصوصية</a></section>

<script>
const toolSearch = document.querySelector<HTMLInputElement>("#tool-search");
const toolCards = [...document.querySelectorAll<HTMLElement>("#tool-grid .tool-card")];
const categoryButtons = [...document.querySelectorAll<HTMLButtonElement>(".category-filter")];
const toolResults = document.querySelector<HTMLElement>("#tool-results");
let activeCategory = "all";
function filterTools() {
  const query = (toolSearch?.value || "").trim().toLocaleLowerCase("ar");
  let visible = 0;
  for (const card of toolCards) {
    const matchesCategory = activeCategory === "all" || card.dataset.category === activeCategory;
    const matchesQuery = !query || ((card.dataset.search || "") + " " + card.innerText).toLocaleLowerCase("ar").includes(query);
    card.hidden = !(matchesCategory && matchesQuery);
    if (!card.hidden) visible++;
  }
  if (toolResults) toolResults.textContent = "";
}
filterTools();
toolSearch?.addEventListener("input", filterTools);
for (const button of categoryButtons) button.addEventListener("click", () => {
  activeCategory = button.dataset.category || "all";
  for (const item of categoryButtons) {
    const active = item === button;
    item.classList.toggle("active", active);
    item.setAttribute("aria-pressed", String(active));
  }
  filterTools();
});
</script>
</main>
</BaseLayout>

<style>
