---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="محوّل الملفات — أدوات الصور" description="حوّل صورك وعدّلها واضغطها داخل المتصفح مع أولوية لخصوصية ملفاتك.">
<section class="home-hero">
  <div class="hero-copy">
    <span class="eyebrow"><span class="status-dot"></span> أدوات ملفات بسيطة وخصوصية أوّلًا</span>
    <h1>كل أدوات صورك،<br /><span>في مكان واحد.</span></h1>
    <p class="lead">حوّل الصيغ، واضبط الأبعاد، واقتصص الصور، وجهّز ملفاتك للتنزيل بخطوات واضحة. نُعالج ملفاتك داخل المتصفح كلما أمكن، دون رفعها إلى خادم التحويل.</p>
    <div class="hero-actions"><a class="button" href={`${base}convert/`}>ابدأ بتحويل صورة <span aria-hidden="true">←</span></a><a class="button secondary" href={`${base}guide/`}>كيف تعمل الأدوات؟</a></div>
    <div class="trust-line"><span aria-hidden="true">✓</span> لا حاجة إلى إنشاء حساب <span class="trust-separator">•</span> معالجة محلية في الأدوات المدعومة</div>
  </div>
  <div class="hero-art" aria-label="تصور توضيحي لتحويل الصور">
    <div class="art-glow"></div><div class="file-card file-card-back"><span class="file-icon file-png">PNG</span><span class="file-line"></span><span class="file-line short"></span></div>
    <div class="file-card file-card-front"><div class="photo-sample"><span class="sun"></span><span class="mountain mountain-one"></span><span class="mountain mountain-two"></span></div><div class="art-file-meta"><strong>صورتك</strong><span>جاهزة للتحويل</span></div><span class="convert-arrow" aria-hidden="true">↔</span><span class="file-icon file-webp">WEBP</span></div>
    <div class="floating-check" aria-hidden="true">✓</div>
  </div>
</section>
<section class="section-heading"><div><span class="eyebrow">ماذا تريد أن تفعل؟</span><h2>اختر الأداة المناسبة</h2><p class="muted">ابدأ بالمهمة التي تحتاجها، وستجد إعداداتها في مكان واحد.</p></div><a class="text-link" href={`${base}convert/`}>عرض أدوات الصور <span aria-hidden="true">←</span></a></section>
<div class="tool-filters" aria-label="البحث وتصنيف الأدوات">
  <label class="tool-search"><span aria-hidden="true">⌕</span><input id="tool-search" type="search" placeholder="ابحث باسم الأداة أو الصيغة…" aria-label="ابحث باسم الأداة أو الصيغة" /></label>
  <div class="category-filters" role="group" aria-label="تصنيف الأدوات">
    <button type="button" class="category-filter active" data-category="all" aria-pressed="true">الكل</button>
    <button type="button" class="category-filter" data-category="convert" aria-pressed="false">تحويل الصيغ</button>
    <button type="button" class="category-filter" data-category="edit" aria-pressed="false">تحرير الصور</button>
    <button type="button" class="category-filter" data-category="compress" aria-pressed="false">ضغط الصور</button>
    <button type="button" class="category-filter" data-category="advanced" aria-pressed="false">الأبعاد المتقدمة</button>
  </div>
  <p id="tool-results" class="tool-results" aria-live="polite">4 أدوات متاحة</p>
</div>
<section class="tool-grid" id="tool-grid" aria-label="أدوات المنصة">
  <a class="tool-card featured" data-category="convert" data-search="تحويل صيغ الصور png jpeg jpg webp bmp تحويل صيغة" href={`${base}convert/#format-panel`}><span class="tool-icon icon-blue" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h15m-4-4 4 4-4 4M20 17H5m4-4-4 4 4 4"/></svg></span><span class="tool-card-title">تحويل صيغ الصور</span><span class="tool-card-description">حوّل إلى PNG أو JPEG أو WebP أو BMP، مع توضيح خصائص كل صيغة.</span><span class="tool-card-action">ابدأ التحويل <span aria-hidden="true">←</span></span><span class="tool-tag">الأداة الأساسية</span></a>
  <a class="tool-card" data-category="advanced" data-search="اقتصاص قص تغيير الأبعاد المقاس الحجم crop resize" href={`${base}convert/#crop-panel`}><span class="tool-icon icon-violet" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4M8 8h8v8H8z"/></svg></span><span class="tool-card-title">اقتصاص وتغيير الأبعاد</span><span class="tool-card-description">حدّد الجزء المطلوب، واضبط مقاس الصورة قبل التصدير.</span><span class="tool-card-action">فتح المحرر <span aria-hidden="true">←</span></span></a>
  <a class="tool-card" data-category="compress" data-search="ضغط الصور تقليل الحجم الجودة jpeg webp compress" href={`${base}convert/#quality`}><span class="tool-icon icon-green" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h12M4 17h8"/><circle cx="18" cy="12" r="2"/><circle cx="14" cy="17" r="2"/></svg></span><span class="tool-card-title">ضغط الصور</span><span class="tool-card-description">اضبط جودة JPEG وWebP وقارن حجم الملف الناتج بالأصل.</span><span class="tool-card-action">تقليل الحجم <span aria-hidden="true">←</span></span></a>
  <a class="tool-card" data-category="edit" data-search="إزالة الخلفية شفافية تحرير الصور background remove" href={`${base}convert/#panel-background`}><span class="tool-icon icon-orange" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 3.5v17a8.5 8.5 0 0 0 0-17Z"/></svg></span><span class="tool-card-title">إزالة الخلفية</span><span class="tool-card-description">جرّب إزالة خلفية الصور محليًا، مع معاينة الشفافية قبل الحفظ.</span><span class="tool-card-action">تجربة الأداة <span aria-hidden="true">←</span></span><span class="tool-tag tag-experimental">تجريبية</span></a>
</section>
<section class="privacy-strip"><span class="privacy-icon" aria-hidden="true">⌑</span><div><h2>ملفاتك تبقى على جهازك</h2><p>أدوات التحويل الأساسية تعمل داخل المتصفح. بعض الميزات قد تحتاج إلى تنزيل مكتبة أو نموذج في أول استخدام؛ نوضح ذلك قبل بدء المعالجة.</p></div><a href={`${base}privacy/`}>اقرأ سياسة الخصوصية</a></section>
<section class="home-bottom"><div><h2>مصممة لتكون سهلة من البداية</h2><p class="muted">واجهة عربية واضحة، ومعاينة مناسبة لحجم الشاشة، ونتيجة يمكنك مراجعتها قبل التنزيل.</p></div><a class="button" href={`${base}convert/`}>افتح محرر الصور</a></section>
<script>
const toolSearch = document.querySelector("#tool-search");
const toolCards = [...document.querySelectorAll("#tool-grid .tool-card")];
const categoryButtons = [...document.querySelectorAll(".category-filter")];
const toolResults = document.querySelector("#tool-results");
let activeCategory = "all";
function filterTools() {
  const query = (toolSearch?.value || "").trim().toLocaleLowerCase("ar");
  let visible = 0;
  for (const card of toolCards) {
    const matchesCategory = activeCategory === "all" || card.dataset.category === activeCategory;
    const matchesQuery = !query || (card.dataset.search + " " + card.innerText).toLocaleLowerCase("ar").includes(query);
    card.hidden = !(matchesCategory && matchesQuery);
    if (!card.hidden) visible++;
  }
  toolResults.textContent = visible + (visible === 1 ? " أداة متاحة" : " أدوات متاحة");
}
toolSearch?.addEventListener("input", filterTools);
for (const button of categoryButtons) button.addEventListener("click", () => {
  activeCategory = button.dataset.category;
  for (const item of categoryButtons) {
    const active = item === button;
    item.classList.toggle("active", active);
    item.setAttribute("aria-pressed", String(active));
  }
  filterTools();
});
</script>
</BaseLayout>
<style>
.home-hero{display:grid;grid-template-columns:1.12fr .88fr;align-items:center;gap:42px;padding:32px 0 58px;min-height:410px}.hero-copy{max-width:700px}.status-dot{width:8px;height:8px;border-radius:50%;background:#22a06b;display:inline-block;box-shadow:0 0 0 4px #22a06b18}.home-hero h1{font-size:clamp(2.5rem,5.6vw,4.25rem);line-height:1.2;margin:18px 0;letter-spacing:-.055em}.home-hero h1 span{color:#3157c8}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}.trust-line{display:flex;align-items:center;gap:8px;flex-wrap:wrap;color:#64748b;font-size:.9rem;margin-top:22px}.trust-line>span:first-child{display:grid;place-items:center;width:21px;height:21px;border-radius:50%;background:#e4f8eb;color:#16804a;font-weight:800}.trust-separator{color:#b2bdcc}.hero-art{position:relative;min-height:340px;display:grid;place-items:center;isolation:isolate}.art-glow{position:absolute;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,#e2eaff 0%,#eef3ff 58%,#f4f7fb 72%);z-index:-1}.file-card{position:absolute;background:#fff;border:1px solid #e2e8f0;border-radius:20px;box-shadow:0 22px 55px #263a6515}.file-card-back{width:210px;height:230px;top:38px;right:20px;transform:rotate(9deg);padding:24px;opacity:.78}.file-line{display:block;height:8px;width:100%;background:#edf1f7;border-radius:9px;margin-top:17px}.file-line.short{width:60%;margin-top:10px}.file-card-front{width:265px;padding:18px;left:20px;top:75px;transform:rotate(-4deg)}.photo-sample{height:145px;position:relative;overflow:hidden;border-radius:13px;background:linear-gradient(180deg,#c6e5ff,#f4e9d6 70%,#d6eadb)}.sun{position:absolute;top:22px;left:32px;width:35px;height:35px;border-radius:50%;background:#ffd477}.mountain{position:absolute;bottom:-20px;width:190px;height:130px;transform:rotate(45deg);border-radius:15px}.mountain-one{left:-16px;background:#78a6a0}.mountain-two{right:-65px;bottom:-48px;background:#4f777b}.art-file-meta{display:flex;flex-direction:column;margin-top:13px;font-size:.9rem}.art-file-meta span{color:#64748b;font-size:.8rem}.convert-arrow{position:absolute;left:-20px;top:115px;display:grid;place-items:center;width:44px;height:44px;border-radius:15px;background:#3157c8;color:#fff;font-size:1.55rem;box-shadow:0 8px 18px #3157c84a}.file-icon{position:absolute;top:18px;left:18px;border-radius:8px;padding:5px 8px;font-size:.7rem;font-weight:850;letter-spacing:.04em}.file-png{background:#e8efff;color:#3157c8}.file-webp{position:static;display:inline-block;margin-top:13px;background:#e5f8ed;color:#16804a;align-self:flex-start}.floating-check{position:absolute;bottom:30px;right:28px;width:48px;height:48px;display:grid;place-items:center;border-radius:50%;background:#e4f8eb;color:#16804a;border:5px solid #f4f7fb;font-size:1.3rem;font-weight:900}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:18px;margin:20px 0 22px}.section-heading h2,.home-bottom h2{margin:6px 0;font-size:1.75rem;letter-spacing:-.035em}.section-heading p{margin:0}.text-link{font-weight:750;white-space:nowrap}.tool-filters{display:grid;grid-template-columns:minmax(220px,.8fr) 2fr;gap:12px;align-items:center;margin:0 0 18px}.tool-search{display:flex;align-items:center;gap:10px;min-height:48px;padding:0 15px;border:1px solid #dce3ee;border-radius:14px;background:#fff;color:#6b7890}.tool-search span{font-size:1.5rem}.tool-search input{width:100%;min-width:0;border:0;outline:0;background:transparent;color:#17233d;font:inherit}.category-filters{display:flex;flex-wrap:wrap;gap:8px}.category-filter{min-height:42px;padding:8px 14px;border:1px solid #dce3ee;border-radius:12px;background:#fff;color:#52617a;font:inherit;font-size:.9rem;font-weight:700;cursor:pointer}.category-filter.active{background:#eaf0ff;border-color:#b9c9ff;color:#2749aa}.tool-results{grid-column:1/-1;margin:0;color:#748197;font-size:.82rem}.tool-card[hidden]{display:none}.tool-icon svg{width:25px;height:25px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.tool-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.tool-card{position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:12px;min-height:245px;padding:22px;background:#fff;border:1px solid #e2e8f0;border-radius:18px;color:#172033;transition:transform .18s,border-color .18s,box-shadow .18s}.tool-card:hover{transform:translateY(-3px);border-color:#b9c8f4;box-shadow:0 14px 32px #1720330c;text-decoration:none}.tool-card.featured{border-color:#b8c8fa;background:linear-gradient(155deg,#fff,#f6f8ff)}.tool-icon{width:49px;height:49px;display:grid;place-items:center;border-radius:15px;font-size:1.8rem;font-weight:700}.icon-blue{background:#e8efff;color:#3157c8}.icon-violet{background:#f0eaff;color:#7847c7}.icon-green{background:#e5f8ed;color:#16804a}.icon-orange{background:#fff0df;color:#b76b13}.tool-card-title{font-size:1.08rem;font-weight:850}.tool-card-description{font-size:.91rem;line-height:1.75;color:#64748b}.tool-card-action{margin-top:auto;color:#3157c8;font-weight:800;font-size:.9rem}.tool-tag{position:absolute;top:17px;left:17px;padding:4px 8px;border-radius:8px;background:#e8efff;color:#3157c8;font-size:.68rem;font-weight:800}.tag-experimental{background:#fff0df;color:#9a5b12}.privacy-strip{display:flex;align-items:center;gap:18px;margin-top:30px;padding:22px 24px;border:1px solid #cdebd8;border-radius:18px;background:#f0faf4}.privacy-icon{flex:0 0 48px;width:48px;height:48px;display:grid;place-items:center;background:#dff5e7;border-radius:15px;color:#18794e;font-size:1.65rem}.privacy-strip h2{font-size:1.1rem;margin:0 0 3px}.privacy-strip p{margin:0;color:#52715f;font-size:.9rem}.privacy-strip>a{margin-right:auto;white-space:nowrap;font-weight:750;font-size:.88rem}.home-bottom{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:44px 0 12px}.home-bottom p{margin:5px 0}
@media(max-width:960px){.tool-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.home-hero{gap:18px}.hero-art{transform:scale(.92)}}@media(max-width:640px){.home-hero{grid-template-columns:1fr;padding:15px 0 35px;gap:0}.home-hero h1{font-size:2.65rem}.hero-art{min-height:270px;transform:scale(.88);margin:-8px 0 0}.section-heading{align-items:flex-start;flex-direction:column}.tool-grid{grid-template-columns:1fr}.tool-card{min-height:unset}.privacy-strip{align-items:flex-start;flex-wrap:wrap;padding:18px}.privacy-strip>a{margin-right:0}.home-bottom{align-items:flex-start;flex-direction:column;padding-top:32px}}
</style>