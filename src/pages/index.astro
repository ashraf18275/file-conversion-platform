---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="محوّل الملفات — أدوات الصور" description="حوّل صورك وعدّلها واضغطها داخل المتصفح مع أولوية لخصوصية ملفاتك.">
<section class="home-hero">
  <div class="hero-copy">
    <span class="eyebrow"><span class="status-dot"></span> أدوات ملفات بسيطة وخصوصية أوّلًا</span>
    <h1>كل أدوات صورك،<br /><span>في مكان واحد.</span></h1>
    <p class="lead">حوّل الصيغ، واضبط الأبعاد، واقتصص الصور، وجهّز ملفاتك للتنزيل بخطوات واضحة. نُعالج ملفاتك داخل المتصفح كلما أمكن، دون رفعها إلى خادم التحويل.</p>
    <div class="hero-actions"><a class="button" href={`${base}convert/`}>ابدأ بتحويل صورة <span aria-hidden="true">←</span></a><a class="button secondary" href={`${base}guide/`}>كيف تعمل الأدوات؟</a></div>
    <div class="trust-line"><span aria-hidden="true">✓</span> لا حاجة إلى إنشاء حساب <span class="trust-separator">•</span> معالجة محلية في الأدوات المدعومة</div>
  </div>
  <div class="hero-art" aria-label="تصور توضيحي لتحويل الصور">
    <div class="art-glow"></div><div class="file-card file-card-back"><span class="file-icon file-png">PNG</span><span class="file-line"></span><span class="file-line short"></span></div>
    <div class="file-card file-card-front"><div class="photo-sample"><span class="sun"></span><span class="mountain mountain-one"></span><span class="mountain mountain-two"></span></div><div class="art-file-meta"><strong>صورتك</strong><span>جاهزة للتحويل</span></div><span class="convert-arrow" aria-hidden="true">↔</span><span class="file-icon file-webp">WEBP</span></div>
    <div class="floating-check" aria-hidden="true">✓</div>
  </div>
</section>
<section class="section-heading"><div><span class="eyebrow">ماذا تريد أن تفعل؟</span><h2>اختر الأداة المناسبة</h2><p class="muted">ابدأ بالمهمة التي تحتاجها، وستجد إعداداتها في مكان واحد.</p></div><a class="text-link" href={`${base}convert/`}>عرض أدوات الصور <span aria-hidden="true">←</span></a></section>
<section class="tool-grid" aria-label="أدوات المنصة">
  <a class="tool-card featured" href={`${base}convert/#format`}><span class="tool-icon icon-blue" aria-hidden="true">↔</span><span class="tool-card-title">تحويل صيغ الصور</span><span class="tool-card-description">حوّل إلى PNG أو JPEG أو WebP، وتعرّف على الصيغ المتاحة.</span><span class="tool-card-action">ابدأ التحويل <span aria-hidden="true">←</span></span><span class="tool-tag">الأداة الأساسية</span></a>
  <a class="tool-card" href={`${base}convert/#crop`}><span class="tool-icon icon-violet" aria-hidden="true">⌗</span><span class="tool-card-title">اقتصاص وتغيير الأبعاد</span><span class="tool-card-description">حدّد الجزء المطلوب، واضبط مقاس الصورة قبل التصدير.</span><span class="tool-card-action">فتح المحرر <span aria-hidden="true">←</span></span></a>
  <a class="tool-card" href={`${base}convert/#quality`}><span class="tool-icon icon-green" aria-hidden="true">◈</span><span class="tool-card-title">ضغط الصور</span><span class="tool-card-description">اضبط جودة JPEG وWebP وقارن حجم الملف الناتج بالأصل.</span><span class="tool-card-action">تقليل الحجم <span aria-hidden="true">←</span></span></a>
  <a class="tool-card" href={`${base}convert/#background`}><span class="tool-icon icon-orange" aria-hidden="true">◐</span><span class="tool-card-title">إزالة الخلفية</span><span class="tool-card-description">جرّب إزالة خلفية الصور محليًا، مع معاينة الشفافية قبل الحفظ.</span><span class="tool-card-action">تجربة الأداة <span aria-hidden="true">←</span></span><span class="tool-tag tag-experimental">تجريبية</span></a>
</section>
<section class="privacy-strip"><span class="privacy-icon" aria-hidden="true">⌑</span><div><h2>ملفاتك تبقى على جهازك</h2><p>أدوات التحويل الأساسية تعمل داخل المتصفح. بعض الميزات قد تحتاج إلى تنزيل مكتبة أو نموذج في أول استخدام؛ نوضح ذلك قبل بدء المعالجة.</p></div><a href={`${base}privacy/`}>اقرأ سياسة الخصوصية</a></section>
<section class="home-bottom"><div><h2>مصممة لتكون سهلة من البداية</h2><p class="muted">واجهة عربية واضحة، ومعاينة مناسبة لحجم الشاشة، ونتيجة يمكنك مراجعتها قبل التنزيل.</p></div><a class="button" href={`${base}convert/`}>افتح محرر الصور</a></section>
</BaseLayout>
<style>
.home-hero{display:grid;grid-template-columns:1.12fr .88fr;align-items:center;gap:42px;padding:32px 0 58px;min-height:410px}.hero-copy{max-width:700px}.status-dot{width:8px;height:8px;border-radius:50%;background:#22a06b;display:inline-block;box-shadow:0 0 0 4px #22a06b18}.home-hero h1{font-size:clamp(2.5rem,5.6vw,4.25rem);line-height:1.2;margin:18px 0;letter-spacing:-.055em}.home-hero h1 span{color:#3157c8}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}.trust-line{display:flex;align-items:center;gap:8px;flex-wrap:wrap;color:#64748b;font-size:.9rem;margin-top:22px}.trust-line>span:first-child{display:grid;place-items:center;width:21px;height:21px;border-radius:50%;background:#e4f8eb;color:#16804a;font-weight:800}.trust-separator{color:#b2bdcc}.hero-art{position:relative;min-height:340px;display:grid;place-items:center;isolation:isolate}.art-glow{position:absolute;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,#e2eaff 0%,#eef3ff 58%,#f4f7fb 72%);z-index:-1}.file-card{position:absolute;background:#fff;border:1px solid #e2e8f0;border-radius:20px;box-shadow:0 22px 55px #263a6515}.file-card-back{width:210px;height:230px;top:38px;right:20px;transform:rotate(9deg);padding:24px;opacity:.78}.file-line{display:block;height:8px;width:100%;background:#edf1f7;border-radius:9px;margin-top:17px}.file-line.short{width:60%;margin-top:10px}.file-card-front{width:265px;padding:18px;left:20px;top:75px;transform:rotate(-4deg)}.photo-sample{height:145px;position:relative;overflow:hidden;border-radius:13px;background:linear-gradient(180deg,#c6e5ff,#f4e9d6 70%,#d6eadb)}.sun{position:absolute;top:22px;left:32px;width:35px;height:35px;border-radius:50%;background:#ffd477}.mountain{position:absolute;bottom:-20px;width:190px;height:130px;transform:rotate(45deg);border-radius:15px}.mountain-one{left:-16px;background:#78a6a0}.mountain-two{right:-65px;bottom:-48px;background:#4f777b}.art-file-meta{display:flex;flex-direction:column;margin-top:13px;font-size:.9rem}.art-file-meta span{color:#64748b;font-size:.8rem}.convert-arrow{position:absolute;left:-20px;top:115px;display:grid;place-items:center;width:44px;height:44px;border-radius:15px;background:#3157c8;color:#fff;font-size:1.55rem;box-shadow:0 8px 18px #3157c84a}.file-icon{position:absolute;top:18px;left:18px;border-radius:8px;padding:5px 8px;font-size:.7rem;font-weight:850;letter-spacing:.04em}.file-png{background:#e8efff;color:#3157c8}.file-webp{position:static;display:inline-block;margin-top:13px;background:#e5f8ed;color:#16804a;align-self:flex-start}.floating-check{position:absolute;bottom:30px;right:28px;width:48px;height:48px;display:grid;place-items:center;border-radius:50%;background:#e4f8eb;color:#16804a;border:5px solid #f4f7fb;font-size:1.3rem;font-weight:900}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:18px;margin:20px 0 22px}.section-heading h2,.home-bottom h2{margin:6px 0;font-size:1.75rem;letter-spacing:-.035em}.section-heading p{margin:0}.text-link{font-weight:750;white-space:nowrap}.tool-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.tool-card{position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:12px;min-height:245px;padding:22px;background:#fff;border:1px solid #e2e8f0;border-radius:18px;color:#172033;transition:transform .18s,border-color .18s,box-shadow .18s}.tool-card:hover{transform:translateY(-3px);border-color:#b9c8f4;box-shadow:0 14px 32px #1720330c;text-decoration:none}.tool-card.featured{border-color:#b8c8fa;background:linear-gradient(155deg,#fff,#f6f8ff)}.tool-icon{width:49px;height:49px;display:grid;place-items:center;border-radius:15px;font-size:1.8rem;font-weight:700}.icon-blue{background:#e8efff;color:#3157c8}.icon-violet{background:#f0eaff;color:#7847c7}.icon-green{background:#e5f8ed;color:#16804a}.icon-orange{background:#fff0df;color:#b76b13}.tool-card-title{font-size:1.08rem;font-weight:850}.tool-card-description{font-size:.91rem;line-height:1.75;color:#64748b}.tool-card-action{margin-top:auto;color:#3157c8;font-weight:800;font-size:.9rem}.tool-tag{position:absolute;top:17px;left:17px;padding:4px 8px;border-radius:8px;background:#e8efff;color:#3157c8;font-size:.68rem;font-weight:800}.tag-experimental{background:#fff0df;color:#9a5b12}.privacy-strip{display:flex;align-items:center;gap:18px;margin-top:30px;padding:22px 24px;border:1px solid #cdebd8;border-radius:18px;background:#f0faf4}.privacy-icon{flex:0 0 48px;width:48px;height:48px;display:grid;place-items:center;background:#dff5e7;border-radius:15px;color:#18794e;font-size:1.65rem}.privacy-strip h2{font-size:1.1rem;margin:0 0 3px}.privacy-strip p{margin:0;color:#52715f;font-size:.9rem}.privacy-strip>a{margin-right:auto;white-space:nowrap;font-weight:750;font-size:.88rem}.home-bottom{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:44px 0 12px}.home-bottom p{margin:5px 0}
@media(max-width:960px){.tool-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.home-hero{gap:18px}.hero-art{transform:scale(.92)}}@media(max-width:640px){.home-hero{grid-template-columns:1fr;padding:15px 0 35px;gap:0}.home-hero h1{font-size:2.65rem}.hero-art{min-height:270px;transform:scale(.88);margin:-8px 0 0}.section-heading{align-items:flex-start;flex-direction:column}.tool-grid{grid-template-columns:1fr}.tool-card{min-height:unset}.privacy-strip{align-items:flex-start;flex-wrap:wrap;padding:18px}.privacy-strip>a{margin-right:0}.home-bottom{align-items:flex-start;flex-direction:column;padding-top:32px}}
</style>