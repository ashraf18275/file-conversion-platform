---
import BaseLayout from "../layouts/BaseLayout.astro";
import { plannedTools } from "../data/tool-catalog";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="محوّل الملفات — أدوات الصور" description="حوّل صورك وعدّلها واضغطها داخل المتصفح مع أولوية لخصوصية ملفاتك.">
<section class="home-hero">
  <div class="hero-copy">
    <span class="eyebrow"><span class="status-dot"></span> أدوات ملفات بسيطة وخصوصية أوّلًا</span>
    <h1>كل أدوات صورك،<br /><span>في مكان واحد.</span></h1>
    <p class="lead">حوّل الصيغ، واضبط الأبعاد، واقتصص الصور، وجهّز ملفاتك للتنزيل بخطوات واضحة. نُعالج ملفاتك داخل المتصفح كلما أمكن، دون رفعها إلى خادم التحويل.</p>
    <div class="hero-actions"><a class="button" href={`${base}convert/`}>ابدأ بتحويل صورة <span aria-hidden="true">←</span></a><a class="button secondary" href={`${base}guide/`}>كيف تعمل الأدوات؟</a></div>
    <div class="trust-line"><span aria-hidden="true">✓</span> لا حاجة إلى إنشاء حساب <span class="trust-separator">•</span> معالجة محلية في الأدوات المدعومة</div>
  </div>
  <div class="hero-art" aria-label="تصور توضيحي لتحويل الصور">
    <div class="art-glow"></div><div class="file-card file-card-back"><span class="file-icon file-png">PNG</span><span class="file-line"></span><span class="file-line short"></span></div>
    <div class="file-card file-card-front"><div class="photo-sample"><span class="sun"></span><span class="mountain mountain-one"></span><span class="mountain mountain-two"></span></div><div class="art-file-meta"><strong>صورتك</strong><span>جاهزة للتحويل</span></div><span class="convert-arrow" aria-hidden="true">↔</span><span class="file-icon file-webp">WEBP</span></div>
    <div class="floating-check" aria-hidden="true">✓</div>
  </div>
</section>
<section class="section-heading"><div><span class="eyebrow">ماذا تريد أن تفعل؟</span><h2>اختر الأداة المناسبة</h2><p class="muted">ابدأ بالمهمة التي تحتاجها، وستجد إعداداتها في مكان واحد.</p></div><a class="text-link" href={`${base}convert/`}>عرض أدوات الصور <span aria-hidden="true">←</span></a></section>
<div class="tool-filters" aria-label="البحث وتصنيف الأدوات">
  <label class="tool-search"><span aria-hidden="true">⌕</span><input id="tool-search" type="search" placeholder="ابحث باسم الأداة أو الصيغة…" aria-label="ابحث باسم الأداة أو الصيغة" /></label>
  <div class="category-filters" role="group" aria-label="تصنيف الأدوات">
    <button type="button" class="category-filter active" data-category="all" aria-pressed="true">الكل</button>
    <button type="button" class="category-filter" data-category="convert" aria-pressed="false">تحويل الصيغ</button>
    <button type="button" class="category-filter" data-category="edit" aria-pressed="false">تحرير الصور</button>
    <button type="button" class="category-filter" data-category="compress" aria-pressed="false">ضغط الصور</button>
    <button type="button" class="category-filter" data-category="advanced" aria-pressed="false">الأبعاد المتقدمة</button>
    <button type="button" class="category-filter" data-category="pdf" aria-pressed="false">أدوات PDF</button>
    <button type="button" class="category-filter" data-category="documents" aria-pressed="false">المستندات</button>
    <button type="button" class="category-filter" data-category="audio" aria-pressed="false">الصوت</button>
    <button type="button" class="category-filter" data-category="video" aria-pressed="false">الفيديو</button>
    <button type="button" class="category-filter" data-category="files" aria-pressed="false">الملفات والأرشيف</button>
  </div>
  <p id="tool-results" class="tool-results" aria-live="polite">27 أداة في الدليل</p>
</div>
<section class="tool-grid" id="tool-grid" aria-label="أدوات المنصة">
  <a class="tool-card featured" data-category="convert" data-search="تحويل صيغ الصور png jpeg jpg webp bmp تحويل صيغة" href={`${base}convert/#format-panel`}><span class="tool-icon icon-blue" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h15m-4-4 4 4-4 4M20 17H5m4-4-4 4 4 4"/></svg></span><span class="tool-card-title">تحويل صيغ الصور</span><span class="tool-card-description">حوّل إلى PNG أو JPEG أو WebP أو BMP، مع توضيح خصائص كل صيغة.</span><span class="tool-card-action">ابدأ التحويل <span aria-hidden="true">←</span></span><span class="tool-tag">الأداة الأساسية</span></a>
  <a class="tool-card" data-category="advanced" data-search="اقتصاص قص تغيير الأبعاد المقاس الحجم crop resize" href={`${base}convert/#crop-panel`}><span class="tool-icon icon-violet" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4M8 8h8v8H8z"/></svg></span><span class="tool-card-title">اقتصاص وتغيير الأبعاد</span><span class="tool-card-description">حدّد الجزء المطلوب، واضبط مقاس الصورة قبل التصدير.</span><span class="tool-card-action">فتح المحرر <span aria-hidden="true">←</span></span></a>
  <a class="tool-card" data-category="compress" data-search="ضغط الصور تقليل الحجم الجودة jpeg webp compress" href={`${base}convert/#quality`}><span class="tool-icon icon-green" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h12M4 17h8"/><circle cx="18" cy="12" r="2"/><circle cx="14" cy="17" r="2"/></svg></span><span class="tool-card-title">ضغط الصور</span><span class="tool-card-description">اضبط جودة JPEG وWebP وقارن حجم الملف الناتج بالأصل.</span><span class="tool-card-action">تقليل الحجم <span aria-hidden="true">←</span></span></a>
  <a class="tool-card" data-category="edit" data-search="تحسين الصور سطوع إضاءة تباين ألوان تشبع تحسين enhance photo" href={`${base}convert/#panel-enhance`}><span class="tool-icon icon-violet" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1m0-12.8-2.1 2.1m-8.6 8.6-2.1 2.1"/><circle cx="12" cy="12" r="4.2"/></svg></span><span class="tool-card-title">تحسين الصور</span><span class="tool-card-description">اضبط السطوع والتباين وتشبع الألوان، وراجع النتيجة قبل التنزيل.</span><span class="tool-card-action">تحسين الصورة <span aria-hidden="true">←</span></span></a>
  <a class="tool-card" data-category="edit" data-search="إزالة الخلفية شفافية تحرير الصور background remove" href={`${base}convert/#panel-background`}><span class="tool-icon icon-orange" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 3.5v17a8.5 8.5 0 0 0 0-17Z"/></svg></span><span class="tool-card-title">إزالة الخلفية</span><span class="tool-card-description">جرّب إزالة خلفية الصور محليًا، مع معاينة الشفافية قبل الحفظ.</span><span class="tool-card-action">تجربة الأداة <span aria-hidden="true">←</span></span><span class="tool-tag tag-experimental">تجريبية</span></a>
  <a class="tool-card" data-category="edit" data-search="تدوير الصور قلب أفقي رأسي rotate flip" href={`${base}convert/#panel-transform`}><span class="tool-icon icon-blue" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 7v5h-5M4 17v-5h5M5.6 9A7 7 0 0 1 18 6l2 6M4 12l2 6a7 7 0 0 0 12.4-3"/></svg></span><span class="tool-card-title">التدوير والقلب</span><span class="tool-card-description">دوّر الصورة أو اقلبها أفقيًا ورأسيًا قبل التصدير.</span><span class="tool-card-action">فتح أدوات التدوير <span aria-hidden="true">←</span></span></a>
  {plannedTools.map((tool) => (
    <a class="tool-card planned-tool-card" data-category={tool.category} data-search={tool.name + " " + tool.categoryLabel + " " + tool.description + " " + tool.slug} href={base + "tools/" + tool.slug + "/"}>
      <span class="tool-icon icon-blue planned-tool-icon" aria-hidden="true">{tool.iconLabel}</span>
      <span class="tool-card-title">{tool.name}</span>
      <span class="tool-card-description">{tool.description}</span>
      <span class="tool-card-action">عرض تفاصيل الأداة <span aria-hidden="true">←</span></span>
      <span class="tool-tag tag-coming-soon">قريبًا</span>
    </a>
  ))}
</section>
<section class="privacy-strip"><span class="privacy-icon" aria-hidden="true">⌑</span><div><h2>ملفاتك تبقى على جهازك</h2><p>أدوات التحويل الأساسية تعمل داخل المتصفح. بعض الميزات قد تحتاج إلى تنزيل مكتبة أو نموذج في أول استخدام؛ نوضح ذلك قبل بدء المعالجة.</p></div><a href={`${base}privacy/`}>اقرأ سياسة الخصوصية</a></section>
<section class="home-bottom"><div><h2>مصممة لتكون سهلة من البداية</h2><p class="muted">واجهة عربية واضحة، ومعاينة مناسبة لحجم الشاشة، ونتيجة يمكنك مراجعتها قبل التنزيل.</p></div><a class="button" href={`${base}convert/`}>افتح محرر الصور</a></section>
<script>
const toolSearch = document.querySelector<HTMLInputElement>("#tool-search");
const toolCards = [...document.querySelectorAll<HTMLElement>("#tool-grid .tool-card")];
const categoryButtons = [...document.querySelectorAll<HTMLButtonElement>(".category-filter")];
const toolResults = document.querySelector<HTMLElement>("#tool-results");
let activeCategory = "all";
function filterTools() {
  const query = (toolSearch?.value || "").trim().toLocaleLowerCase("ar");
  let visible = 0;
  for (const card of toolCards) {
    const matchesCategory = activeCategory === "all" || card.dataset.category === activeCategory;
    const matchesQuery = !query || ((card.dataset.search || "") + " " + card.innerText).toLocaleLowerCase("ar").includes(query);
    card.hidden = !(matchesCategory && matchesQuery);
    if (!card.hidden) visible++;
  }
  if (toolResults) toolResults.textContent = visible + (visible === 1 ? " أداة في الدليل" : " أداة في الدليل");
}
toolSearch?.addEventListener("input", filterTools);
for (const button of categoryButtons) button.addEventListener("click", () => {
  activeCategory = button.dataset.category || "all";
  for (const item of categoryButtons) {
    const active = item === button;
    item.classList.toggle("active", active);
    item.setAttribute("aria-pressed", String(active));
  }
  filterTools();
});
</script>
</BaseLayout>

<style>
.home-hero{position:relative;isolation:isolate;display:grid;grid-template-columns:1.08fr .92fr;align-items:center;gap:clamp(24px,5vw,70px);padding:clamp(30px,5vw,68px);min-height:450px;margin:10px 0 62px;border:1px solid #dfe5f1;border-radius:32px;background:radial-gradient(ellipse at 82% 14%,#e6eaff 0,transparent 35%),linear-gradient(135deg,#fff 0%,#f7f8ff 58%,#eef2ff 100%);overflow:hidden;box-shadow:0 24px 70px #1e2a4a0a}
.home-hero:after{content:"";position:absolute;z-index:-1;left:-95px;bottom:-150px;width:300px;height:300px;border:1px solid #d9e1fa;border-radius:50%;box-shadow:0 0 0 35px #e8edfc6b,0 0 0 70px #e8edfc38}
.hero-copy{max-width:650px}.status-dot{width:8px;height:8px;border-radius:50%;background:#1b9b73;display:inline-block;box-shadow:0 0 0 4px #1b9b7318}.home-hero .eyebrow{padding:8px 12px;border:1px solid #dce4fa;border-radius:999px;background:#fff;color:#4058a5;font-size:.84rem}
.home-hero h1{font-size:clamp(2.65rem,5.3vw,4.65rem);line-height:1.18;margin:22px 0 18px;letter-spacing:-.055em;color:#111b33;font-weight:800}.home-hero h1 span{color:#4b55d7}.home-hero .lead{font-size:clamp(1rem,1.5vw,1.12rem);line-height:1.95;max-width:600px;color:#5a6680}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.hero-actions .button{min-height:54px;padding-inline:23px;border-radius:15px}.hero-actions .button.secondary{background:#fff;border-color:#dce3f1;color:#34415c}.trust-line{display:flex;align-items:center;gap:9px;flex-wrap:wrap;color:#64718a;font-size:.86rem;margin-top:23px}.trust-line>span:first-child{display:grid;place-items:center;width:22px;height:22px;border-radius:50%;background:#dff6e9;color:#16804a;font-weight:800}.trust-separator{color:#b2bdcc}
.hero-art{position:relative;min-height:340px;display:grid;place-items:center;isolation:isolate}.art-glow{position:absolute;width:min(300px,85%);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,#dce5ff 0%,#eaf0ff 57%,#f4f6ff 72%);z-index:-1}.file-card{position:absolute;background:#fff;border:1px solid #e0e6f2;border-radius:23px;box-shadow:0 28px 65px #263a6518}.file-card-back{width:205px;height:235px;top:28px;right:3%;transform:rotate(8deg);padding:24px;opacity:.94}.file-line{display:block;height:8px;width:100%;background:#edf1f7;border-radius:9px;margin-top:17px}.file-line.short{width:60%;margin-top:10px}.file-card-front{width:min(270px,86%);padding:17px;left:3%;top:66px;transform:rotate(-3deg)}.photo-sample{height:150px;position:relative;overflow:hidden;border-radius:16px;background:linear-gradient(180deg,#c7e5ff,#f6e8d8 70%,#d5eadc)}.sun{position:absolute;top:22px;left:32px;width:35px;height:35px;border-radius:50%;background:#ffd477}.mountain{position:absolute;bottom:-20px;width:190px;height:130px;transform:rotate(45deg);border-radius:15px}.mountain-one{left:-16px;background:#78a6a0}.mountain-two{right:-65px;bottom:-48px;background:#4f777b}.art-file-meta{display:flex;flex-direction:column;margin-top:13px;font-size:.9rem}.art-file-meta span{color:#64748b;font-size:.8rem}.convert-arrow{position:absolute;left:-22px;top:112px;display:grid;place-items:center;width:46px;height:46px;border:4px solid #fff;border-radius:16px;background:#4b55d7;color:#fff;font-size:1.5rem;box-shadow:0 10px 24px #4b55d74a}.file-icon{position:absolute;top:18px;left:18px;border-radius:9px;padding:6px 9px;font-size:.7rem;font-weight:850;letter-spacing:.04em}.file-png{background:#e8efff;color:#3157c8}.file-webp{position:static;display:inline-block;margin-top:13px;background:#e2f7ec;color:#16804a;align-self:flex-start}.floating-check{position:absolute;bottom:18px;right:7%;width:51px;height:51px;display:grid;place-items:center;border-radius:50%;background:#e2f7ec;color:#16804a;border:5px solid #f4f6ff;font-size:1.3rem;font-weight:900;box-shadow:0 10px 24px #1b9b731c}
.section-heading{display:flex;align-items:end;justify-content:space-between;gap:18px;margin:20px 0 24px}.section-heading h2,.home-bottom h2{margin:6px 0;font-size:clamp(1.55rem,2.8vw,2rem);letter-spacing:-.035em;color:#18233b}.section-heading p{margin:0}.text-link{font-weight:800;white-space:nowrap}.tool-filters{display:grid;grid-template-columns:minmax(240px,.75fr) 2fr;gap:14px;align-items:center;margin:0 0 22px;padding:16px;border:1px solid #e0e6f0;border-radius:20px;background:#fff;box-shadow:0 8px 26px #1b2b4b06}.tool-search{display:flex;align-items:center;gap:10px;min-height:52px;padding:0 15px;border:1px solid #dce3ee;border-radius:14px;background:#f8faff;color:#6b7890}.tool-search span{font-size:1.5rem}.tool-search input{width:100%;min-width:0;border:0;outline:0;background:transparent;color:#17233d;font:inherit;box-shadow:none}.category-filters{display:flex;flex-wrap:wrap;gap:8px}.category-filter{min-height:41px;padding:7px 13px;border:1px solid #e0e6f0;border-radius:11px;background:#fff;color:#52617a;font:inherit;font-size:.86rem;font-weight:700;cursor:pointer;transition:all .15s}.category-filter:hover{border-color:#b8c5f4;color:#3e4fc0}.category-filter.active{background:#e9edff;border-color:#cbd4ff;color:#3948b8}.tool-results{grid-column:1/-1;margin:0;color:#748197;font-size:.82rem}.tool-card[hidden]{display:none}.tool-icon svg{width:25px;height:25px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.tool-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.tool-card{position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:13px;min-height:250px;padding:23px;background:#fff;border:1px solid #e1e6ef;border-radius:21px;color:#172033;transition:transform .18s,border-color .18s,box-shadow .18s}.tool-card:hover{transform:translateY(-4px);border-color:#c2ccfa;box-shadow:0 18px 38px #17203310;text-decoration:none}.tool-card:focus-visible{outline:3px solid #7887ef;outline-offset:3px}.tool-card.featured{border-color:#c5cefb;background:linear-gradient(145deg,#fff,#f7f8ff)}.tool-icon{width:52px;height:52px;display:grid;place-items:center;border-radius:16px;font-size:1.8rem;font-weight:700}.icon-blue{background:#e8efff;color:#3157c8}.icon-violet{background:#f0eaff;color:#7847c7}.icon-green{background:#e5f8ed;color:#16804a}.icon-orange{background:#fff0df;color:#b76b13}.tool-card-title{font-size:1.06rem;font-weight:850;letter-spacing:-.015em}.tool-card-description{font-size:.9rem;line-height:1.85;color:#66728a}.tool-card-action{margin-top:auto;color:#4453cb;font-weight:800;font-size:.9rem}.tool-tag{position:absolute;top:17px;left:17px;padding:5px 9px;border-radius:9px;background:#e8efff;color:#3157c8;font-size:.68rem;font-weight:800}.tag-experimental{background:#fff0df;color:#9a5b12}.tag-coming-soon{background:#f0f2f7;color:#58677c}.planned-tool-icon{width:auto;min-width:49px;padding:0 8px;font-size:.72rem;letter-spacing:0;white-space:nowrap}.privacy-strip{display:flex;align-items:center;gap:18px;margin-top:32px;padding:25px 27px;border:1px solid #cce9da;border-radius:22px;background:linear-gradient(110deg,#f0fbf5,#f8fffb)}.privacy-icon{flex:0 0 50px;width:50px;height:50px;display:grid;place-items:center;background:#dff5e7;border-radius:16px;color:#18794e;font-size:1.65rem}.privacy-strip h2{font-size:1.12rem;margin:0 0 3px}.privacy-strip p{margin:0;color:#52715f;font-size:.9rem}.privacy-strip>a{margin-right:auto;white-space:nowrap;font-weight:750;font-size:.88rem}.home-bottom{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:48px 0 12px}.home-bottom p{margin:5px 0}
@media(max-width:1000px){.tool-filters{grid-template-columns:1fr}.tool-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.home-hero{gap:24px;padding:35px}.hero-art{transform:scale(.94)}}
@media(max-width:760px){.tool-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.home-hero{grid-template-columns:1fr;padding:30px 24px 24px;margin-bottom:44px;gap:0}.home-hero h1{font-size:clamp(2.45rem,10vw,3.3rem)}.hero-art{min-height:270px;transform:scale(.9);margin:-2px 0 0}.section-heading{align-items:flex-start;flex-direction:column}.privacy-strip{align-items:flex-start;flex-wrap:wrap;padding:20px}.privacy-strip>a{margin-right:0}}
@media(max-width:480px){.tool-grid{grid-template-columns:1fr}.tool-card{min-height:unset;padding:20px}.tool-filters{padding:12px}.category-filters{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.category-filter{min-height:44px;padding:8px}.home-hero{border-radius:24px;padding:25px 19px 18px}.hero-actions{display:grid;grid-template-columns:1fr}.hero-actions .button{width:100%}.hero-art{min-height:245px;transform:scale(.84);margin:-5px -10px 0}.home-bottom{align-items:flex-start;flex-direction:column;padding-top:32px}}
@media(prefers-reduced-motion:reduce){.tool-card,.button,.category-filter{transition:none} .tool-card:hover,.button:hover{transform:none}}
</style>
