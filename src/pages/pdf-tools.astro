---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="أدوات PDF" description="دليل أدوات PDF المتاحة في محوّل الملفات وحالة المعالجة المحلية.">
  <nav class="breadcrumbs" aria-label="مسار التنقل"><a href={base}>الرئيسية</a><span aria-hidden="true">/</span><span aria-current="page">أدوات PDF</span></nav>
  <section class="collection">
    <span class="eyebrow">دليل PDF</span>
    <h1>أدوات ملفات PDF</h1>
    <p class="lead">هذه الصفحة مخصصة لمسارات العمل على ملفات PDF، مثل التحويل والدمج والتقسيم وتدوير الصفحات.</p>
    <aside class="availability" role="note"><strong>لا توجد أداة PDF مفعّلة للاستخدام حتى الآن.</strong><p>لن نطلب منك اختيار ملف قبل بناء المعالجة المحلية واختبارها. لم يتم إرسال أي ملف من هذه الصفحة.</p></aside>
    <a class="button secondary" href={base}>العودة إلى الصفحة الرئيسية</a>
  </section>
</BaseLayout>
<style>
.breadcrumbs{display:flex;gap:9px;align-items:center;color:var(--muted);font-size:.9rem;margin-bottom:18px}.breadcrumbs a{font-weight:700}.collection{max-width:820px;margin:0 auto 40px;padding:clamp(22px,4vw,40px);background:#fff;border:1px solid var(--line);border-radius:var(--radius)}.collection h1{font-size:clamp(2rem,4vw,2.8rem);margin:7px 0}.availability{margin:24px 0;padding:17px;border:1px solid #f1d6a5;border-radius:12px;background:#fff8ea;color:#71480d}.availability p{margin:4px 0 0;line-height:1.8}
</style>
