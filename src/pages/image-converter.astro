---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="تحويل الصور" description="دليل تحويل الصور وتحريرها في المتصفح. افتح مساحة الصور لمعاينة الخيارات المتاحة قبل الحفظ.">
  <nav class="breadcrumbs" aria-label="مسار التنقل"><a href={base}>الرئيسية</a><span aria-hidden="true">/</span><span aria-current="page">تحويل الصور</span></nav>
  <section class="collection">
    <span class="eyebrow">دليل الصور</span>
    <h1>تحويل الصور وتحريرها</h1>
    <p class="lead">تعرّف على المهام والصيغ، ثم افتح مساحة الصور لمراجعة الخيارات المتاحة فعليًا قبل اختيار ملف.</p>
    <div class="current-tool"><div><h2>مساحة الصور</h2><p>تضم المحرر الحالي لتحويل صيغ الصور وتعديل الأبعاد والقص والتدوير. راجع الخيارات داخل الصفحة؛ بعض الوظائف تحتاج إلى متابعة التحقق.</p></div><a class="button" href={`${base}convert/`}>افتح مساحة الصور <span aria-hidden="true">←</span></a></div>
    <p class="privacy-note">ملفات الصور التي تختارها تُعالج داخل المتصفح في الوظائف المحلية. يمكن التحقق من عدم إرسالها بمراجعة طلبات الشبكة في أدوات المطور؛ تنزيل مكتبة عند الحاجة لا يعني إرسال ملف الصورة.</p>
  </section>
</BaseLayout>
<style>
.breadcrumbs{display:flex;gap:9px;align-items:center;color:var(--muted);font-size:.9rem;margin-bottom:18px}.breadcrumbs a{font-weight:700}.collection{max-width:900px;margin:0 auto 40px}.collection h1{font-size:clamp(2rem,4vw,2.8rem);margin:7px 0}.current-tool{display:flex;align-items:center;justify-content:space-between;gap:24px;margin:25px 0;padding:22px;background:#fff;border:1px solid var(--line);border-radius:var(--radius)}.current-tool h2{margin:0 0 4px;font-size:1.2rem}.current-tool p{margin:0;color:var(--muted);max-width:610px}.current-tool .button{white-space:nowrap}.privacy-note{padding:15px 17px;border-radius:12px;background:var(--soft);color:var(--muted);line-height:1.8}@media(max-width:650px){.current-tool{align-items:stretch;flex-direction:column}.current-tool .button{width:100%}}
</style>
