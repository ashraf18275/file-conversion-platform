---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { plannedTools } from "../../data/tool-catalog";

export function getStaticPaths() {
  return plannedTools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool }
  }));
}

const { tool } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={tool.name} description={tool.description}>
  <nav class="breadcrumbs" aria-label="مسار التنقل">
    <a href={base}>الرئيسية</a><span aria-hidden="true">/</span><a href={base}>الأدوات</a><span aria-hidden="true">/</span><span aria-current="page">{tool.name}</span>
  </nav>
  <section class="planned-hero">
    <span class="eyebrow">من أدوات المنصة المخططة</span>
    <div class="planned-icon" aria-hidden="true">{tool.iconLabel}</div>
    <span class="coming-badge"><span class="coming-dot"></span> قريبًا</span>
    <h1>{tool.name}</h1>
    <p class="lead">{tool.description}</p>
    <div class="planned-note">
      <strong>هذه الأداة لم تُنفّذ بعد.</strong>
      <p>نعرض هذه الصفحة لتوضيح مكان الأداة في خريطة الموقع. لن يظهر هنا رفع ملفات أو زر معالجة حتى تُنفّذ الوظيفة وتُختبر فعليًا.</p>
    </div>
    <div class="planned-privacy"><span aria-hidden="true">✓</span><p><strong>الخصوصية جزء من التصميم</strong><br />سيُفضّل تنفيذ المعالجة داخل المتصفح متى كان ذلك عمليًا. أي استثناء يحتاج إلى مراجعة مستقلة قبل اعتماده.</p></div>
    <a class="button" href={base}>العودة إلى دليل الأدوات <span aria-hidden="true">←</span></a>
  </section>
</BaseLayout>
<style>
.breadcrumbs{display:flex;flex-wrap:wrap;gap:10px;align-items:center;color:#718096;font-size:.9rem;margin:0 0 22px}.breadcrumbs a{font-weight:700}.planned-hero{max-width:780px;margin:28px auto 70px;padding:clamp(24px,5vw,54px);background:#fff;border:1px solid #e2e8f0;border-radius:24px;box-shadow:0 16px 44px #17203308}.planned-icon{display:grid;place-items:center;min-width:68px;width:max-content;height:62px;padding:0 13px;margin:22px 0 12px;border-radius:17px;background:#eef2ff;color:#3157c8;font-size:.88rem;font-weight:850;letter-spacing:.02em}.coming-badge{display:inline-flex;align-items:center;gap:7px;border:1px solid #e2e8f0;border-radius:99px;padding:5px 12px;color:#64748b;background:#f8fafc;font-size:.84rem;font-weight:800}.coming-dot{width:7px;height:7px;border-radius:50%;background:#8b98ab}.planned-hero h1{font-size:clamp(2rem,5vw,3rem);line-height:1.25;margin:12px 0}.planned-note{padding:18px 20px;margin:26px 0;border:1px solid #f2d8a7;border-radius:15px;background:#fff9ed;color:#744b10}.planned-note p{margin:5px 0 0;line-height:1.8}.planned-privacy{display:flex;gap:12px;align-items:flex-start;margin:22px 0 28px;padding:15px 17px;border-radius:14px;background:#effaf4;color:#24583a}.planned-privacy>span{display:grid;place-items:center;flex:0 0 25px;height:25px;border-radius:50%;background:#d7f3e1;font-weight:900}.planned-privacy p{margin:0;font-size:.92rem;line-height:1.8}.planned-hero .button{margin-top:2px}@media(max-width:640px){.planned-hero{margin:12px auto 35px;padding:22px;border-radius:18px}}
</style>
