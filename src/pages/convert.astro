---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="محرر الصور" description="حوّل صور PNG وJPEG وWebP، وغيّر أبعادها واقتصصها واضغطها محليًا داخل المتصفح.">
<section class="card">
<h1 class="editor-page-title visually-hidden">محرر الصور</h1>
<div class="upload-zone" id="upload-zone"><span class="upload-symbol" aria-hidden="true">↑</span><div class="upload-copy"><strong>أضف صورة لبدء العمل</strong><span>اسحب الصور إلى هنا أو اخترها من جهازك</span></div><label class="button upload-button" for="image-file">اختيار صورة أو عدة صور</label><input id="image-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif,image/bmp,image/avif" multiple /></div>
<div class="source-toolbar"><div id="source-info" class="file-meta muted" aria-live="polite">لم يتم اختيار صورة بعد.</div><button id="remove-selected" class="button secondary remove-selected" type="button" disabled>حذف الصورة المختارة</button></div>
<div id="batch-panel" class="batch-panel" hidden><div class="batch-heading"><strong id="batch-count">0 ملفات محددة</strong><button id="batch-convert" class="button" type="button">تحويل جميع الملفات</button></div><ul id="batch-file-list" class="batch-file-list"></ul><p id="batch-status" class="muted" role="status" aria-live="polite"></p><div id="batch-results" class="batch-results"></div></div>
<div id="preview-wrap" class="preview-stage" hidden><img id="preview" class="preview" alt="معاينة الصورة الأصلية" /><div id="crop-overlay" class="crop-overlay" aria-label="اسحب لتحديد مساحة الاقتصاص"><div id="crop-selection" class="crop-selection"><span class="crop-handle handle-nw" data-crop-handle="nw" aria-label="تغيير الزاوية العلوية اليسرى"></span><span class="crop-handle handle-n" data-crop-handle="n" aria-label="تغيير الحافة العلوية"></span><span class="crop-handle handle-ne" data-crop-handle="ne" aria-label="تغيير الزاوية العلوية اليمنى"></span><span class="crop-handle handle-e" data-crop-handle="e" aria-label="تغيير الحافة اليمنى"></span><span class="crop-handle handle-se" data-crop-handle="se" aria-label="تغيير الزاوية السفلية اليمنى"></span><span class="crop-handle handle-s" data-crop-handle="s" aria-label="تغيير الحافة السفلية"></span><span class="crop-handle handle-sw" data-crop-handle="sw" aria-label="تغيير الزاوية السفلية اليسرى"></span><span class="crop-handle handle-w" data-crop-handle="w" aria-label="تغيير الحافة اليسرى"></span></div></div><div class="preview-tip">يمكنك سحب المؤشر على الصورة لتحديد الجزء المطلوب</div></div>

<div class="editor-tabs" role="tablist" aria-label="أدوات تحرير الصورة">
  <button class="editor-tab active" type="button" role="tab" id="tab-export" aria-selected="true" aria-controls="panel-export" data-editor-tab="export">تحويل الصيغ</button>
  <button class="editor-tab" type="button" role="tab" id="tab-size" aria-selected="false" aria-controls="panel-size" data-editor-tab="size">الأبعاد والاقتصاص</button>
  <button class="editor-tab" type="button" role="tab" id="tab-background" aria-selected="false" aria-controls="panel-background" data-editor-tab="background" hidden>إزالة الخلفية</button>
  <button class="editor-tab" type="button" role="tab" id="tab-transform" aria-selected="false" aria-controls="panel-transform" data-editor-tab="transform">التدوير والقلب</button>
  <button class="editor-tab" type="button" role="tab" id="tab-enhance" aria-selected="false" aria-controls="panel-enhance" data-editor-tab="enhance">تحسين الصور</button>
</div>
<div class="editor-tab-panels">
  <div id="panel-size" class="editor-tab-panel" role="tabpanel" aria-labelledby="tab-size" data-editor-panel="size"></div>
  <div id="panel-background" class="editor-tab-panel" role="tabpanel" aria-labelledby="tab-background" data-editor-panel="background" hidden>
    <section class="tool-panel">
      <h2>إزالة الخلفية</h2>
      <p class="muted">أزل خلفية الصورة داخل المتصفح، ثم راجع الحواف والشفافية قبل التنزيل.</p>
      <div class="background-summary"><span class="tool-icon icon-orange" aria-hidden="true">◐</span><div><strong>مصممة أساسًا لصور الأشخاص</strong><p class="muted">قد تحتاج الصور المعقدة أو التفاصيل الدقيقة إلى مراجعة يدوية.</p></div></div>
      <details class="help-details"><summary>معلومات قبل الاستخدام</summary><p>في أول تشغيل، يُنزّل المتصفح مكتبة المعالجة والنموذج من Hugging Face. قد يكون التنزيل كبيرًا؛ لا تُرفع صورة المستخدم إلى خدمة إزالة الخلفية.</p></details>
      <div class="button-row">
        <button id="remove-background" class="button" type="button" disabled>إزالة الخلفية محليًا</button>
        <button id="restore-original" class="button secondary" type="button" hidden>استعادة الصورة الأصلية</button>
      </div>
      <p id="background-status" class="muted hint" role="status" aria-live="polite">اختر صورة لبدء إزالة الخلفية.</p>
      <div class="field">
        <label for="matte-strength">توازن الحواف <output id="matte-strength-value">0.85</output></label>
        <input id="matte-strength" type="range" min="0.65" max="1.4" step="0.05" value="0.85" disabled />
        <small class="muted">حرّكه إلى اليسار للاحتفاظ بمزيد من تفاصيل الشخصية، أو إلى اليمين لتقليل بقايا الخلفية. قد تحتاج إلى الموازنة بين الأمرين.</small>
      </div>
      <p class="muted hint">تحتاج الميزة إلى اتصال بالإنترنت في أول تشغيل لتنزيل مكتبة المعالجة والنموذج. بعد التنزيل يعتمد توفر الاستخدام المتكرر على ذاكرة التخزين المؤقت بالمتصفح.</p>
    </section>
  </div>
  <div id="panel-export" class="editor-tab-panel" role="tabpanel" aria-labelledby="tab-export" data-editor-panel="export" hidden></div>
  <div id="panel-transform" class="editor-tab-panel" role="tabpanel" aria-labelledby="tab-transform" data-editor-panel="transform" hidden></div>
  <div id="panel-enhance" class="editor-tab-panel" role="tabpanel" aria-labelledby="tab-enhance" data-editor-panel="enhance" hidden>
    <section class="tool-panel">
      <h2>تحسين الصور</h2>
      <p class="muted">اضبط الإضاءة والتباين والألوان، ثم قارن المعاينة قبل التنزيل. تتم المعالجة داخل المتصفح.</p>
      <div class="field"><label for="enhance-brightness">السطوع <output id="enhance-brightness-value">100%</output></label><input id="enhance-brightness" type="range" min="50" max="150" step="1" value="100" /></div>
      <div class="field"><label for="enhance-contrast">التباين <output id="enhance-contrast-value">100%</output></label><input id="enhance-contrast" type="range" min="50" max="150" step="1" value="100" /></div>
      <div class="field"><label for="enhance-saturation">تشبّع الألوان <output id="enhance-saturation-value">100%</output></label><input id="enhance-saturation" type="range" min="0" max="180" step="1" value="100" /></div>
      <div class="button-row"><button id="enhance-reset" class="button secondary" type="button">إعادة الضبط</button><button id="enhance-auto" class="button secondary" type="button">تحسين متوازن</button></div>
      <p id="enhance-status" class="muted hint" role="status" aria-live="polite">اختر صورة لتجربة التحسين. التغييرات لا تُحفظ إلا عند الضغط على زر تطبيق التعديلات.</p>
      <p class="muted hint">هذه أدوات ضبط للصورة وليست استعادة تفاصيل مفقودة أو رفعًا بالذكاء الاصطناعي. افحص النتيجة قبل تنزيلها.</p>
    </section>
  </div>
</div>

<details id="resize-panel" class="tool-panel" open>
<summary>الأبعاد والمقاس</summary>
<div class="grid fields-grid">
<div class="field"><label for="width">العرض النهائي (بكسل)</label><input id="width" type="number" min="1" max="12000" inputmode="numeric" value="1200" /></div>
<div class="field"><label for="height">الارتفاع النهائي (بكسل)</label><input id="height" type="number" min="1" max="12000" inputmode="numeric" value="1200" /></div>
</div>
<label class="check-row"><input id="keep-ratio" type="checkbox" checked /> تحديث البعد الآخر تلقائيًا عند تغيير أحد البعدين</label>
<div class="field"><label for="fit-mode">طريقة ملاءمة الصورة</label><select id="fit-mode"><option value="contain">احتواء الصورة كاملة دون اقتطاع (قد تظهر مساحة فارغة)</option><option value="actual">الحفاظ على الأبعاد الأصلية وعدم تغيير الحجم</option></select></div>
<div class="field"><label for="background-mode">خلفية المساحة الفارغة</label><select id="background-mode"><option value="transparent">شفافة في PNG وWebP (موصى به)</option><option value="color">استخدام لون محدد</option></select></div>
<div class="field"><label for="background">لون الخلفية</label><div class="color-row"><input id="background" type="color" value="#ffffff" /><span class="muted">JPEG يستخدم خلفية بيضاء لأن الصيغة لا تدعم الشفافية.</span></div></div>
<p class="muted hint">لن تُقص الصورة عند تغيير الأبعاد. عند اختيار أبعاد مختلفة النسبة، ستظهر الصورة كاملة داخل المساحة المحددة.</p>
</details>

<details id="crop-panel" class="tool-panel" open>
<summary>اقتصاص الصورة</summary>
<p class="muted">اسحب مباشرة فوق الصورة لتحديد الجزء الذي تريد الاحتفاظ به، ثم حرّك المؤشر لتغيير التحديد.</p>
<details class="help-details advanced-fields"><summary>ضبط دقيق بالأرقام (اختياري)</summary>
<div class="grid fields-grid">
<div class="field"><label for="crop-x">بداية الاقتصاص أفقيًا (X)</label><input id="crop-x" type="number" min="0" step="1" value="0" inputmode="numeric" /></div>
<div class="field"><label for="crop-y">بداية الاقتصاص رأسيًا (Y)</label><input id="crop-y" type="number" min="0" step="1" value="0" inputmode="numeric" /></div>
<div class="field"><label for="crop-width">عرض الجزء (بكسل)</label><input id="crop-width" type="number" min="1" step="1" value="1" inputmode="numeric" /></div>
<div class="field"><label for="crop-height">ارتفاع الجزء (بكسل)</label><input id="crop-height" type="number" min="1" step="1" value="1" inputmode="numeric" /></div>
</div>
</details>
<div class="button-row"><button id="use-crop" class="button secondary" type="button" disabled>تفعيل الاقتصاص</button><button id="reset-crop" class="button secondary" type="button" disabled>إلغاء الاقتصاص</button></div>
<p id="crop-info" class="muted hint" aria-live="polite">اختر صورة لتحديد مساحة الاقتصاص.</p>
<div id="crop-preview-wrap" hidden><p class="muted">معاينة الجزء المحدد بالضبط:</p><canvas id="crop-preview" width="240" height="160" aria-label="معاينة الجزء المحدد للاقتصاص"></canvas></div>
</details>

<details id="format-panel" class="tool-panel" open>
<summary>صيغة الإخراج والجودة</summary>
<div class="field"><label for="format">تنسيق الإخراج</label><select id="format"><option value="image/webp">WebP — حجم أصغر غالبًا</option><option value="image/jpeg">JPEG</option><option value="image/png">PNG — يدعم الشفافية</option><option value="image/bmp">BMP — توافق واسع وحجم أكبر</option></select></div>
<div class="field"><label for="quality">جودة JPEG وWebP: <output id="quality-value">0.85</output></label><input id="quality" type="range" min="0.1" max="1" step="0.05" value="0.85" /><small class="muted">الجودة الأقل تعطي عادةً ملفًا أصغر. هذا الخيار لا يؤثر في PNG.</small></div>
<label class="check-row"><input id="target-enabled" type="checkbox" /> استهداف حجم ملف محدد</label>
<div class="field"><label for="target-kb">الحجم المستهدف (كيلوبايت)</label><input id="target-kb" type="number" min="1" max="100000" step="1" value="200" inputmode="numeric" disabled /><small class="muted">سيبحث المحرر عن أعلى جودة ممكنة ضمن الحجم المستهدف. قد يتعذر بلوغ الحجم المطلوب مع بعض الصور أو عند استخدام PNG.</small></div>
</details>

<details id="transform-panel" class="tool-panel" open>
<summary>التدوير والقلب</summary>
<div class="button-row">
<button id="rotate-left" class="button secondary" type="button" disabled>تدوير 90° لليسار</button>
<button id="rotate-right" class="button secondary" type="button" disabled>تدوير 90° لليمين</button>
<button id="flip-horizontal" class="button secondary" type="button" disabled>قلب أفقي</button>
<button id="flip-vertical" class="button secondary" type="button" disabled>قلب رأسي</button>
</div>
<p class="muted hint">يمكنك تجربة التدوير والقلب قبل إنشاء الملف النهائي. تبقى الصورة الأصلية محفوظة.</p>
</details>

<button id="convert" class="button" disabled>تطبيق التعديلات وتحويل الصورة</button>
<p id="status" role="status" aria-live="polite" class="muted"></p>
<div id="result" class="result" hidden><h2>النتيجة</h2><img id="result-preview" class="preview" alt="معاينة الصورة بعد التعديل" /><p id="result-info"></p><div id="target-warning" class="warn" hidden></div><a id="download" class="button" download>تنزيل الصورة</a></div>
</section>
<script is:inline>
const editorTabs = Array.from(document.querySelectorAll("[data-editor-tab]")).filter(tab => !tab.hidden);
const editorPanels = Array.from(document.querySelectorAll("[data-editor-panel]"));
const detailPanels = Array.from(document.querySelectorAll("details.tool-panel"));
const tabAssignment = ["size", "size", "export", "transform"];
detailPanels.forEach((panel, index) => {
  const target = document.querySelector('[data-editor-panel="' + (tabAssignment[index] || "export") + '"]');
  if (target) target.appendChild(panel);
});
const activateEditorTab = (name) => {
  editorTabs.forEach(tab => {
    const active = tab.dataset.editorTab === name;
    tab.classList.toggle("active", active);
    tab.setAttribute("aria-selected", String(active));
    tab.tabIndex = active ? 0 : -1;
  });
  editorPanels.forEach(panel => { panel.hidden = panel.dataset.editorPanel !== name; });
};
editorTabs.forEach((tab, index) => {
  tab.addEventListener("click", () => activateEditorTab(tab.dataset.editorTab));
  tab.addEventListener("keydown", event => {
    if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
    event.preventDefault();
    const next = (index + (event.key === "ArrowLeft" ? 1 : -1) + editorTabs.length) % editorTabs.length;
    editorTabs[next].focus();
    activateEditorTab(editorTabs[next].dataset.editorTab);
  });
});
activateEditorTab("export");
if (location.hash === "#crop-panel") activateEditorTab("size");
if (location.hash === "#panel-enhance") activateEditorTab("enhance");

/* Focus the shared editor on one selected tool when opened from the tools directory. */
const toolModes = {
  convert: { title: "تحويل صيغ الصور", tab: "export", details: ["format-panel"] },
  compress: { title: "ضغط الصور", tab: "export", details: ["format-panel"] },
  resize: { title: "تغيير أبعاد الصور", tab: "size", details: ["resize-panel"] },
  crop: { title: "اقتصاص الصور", tab: "size", details: ["crop-panel"] },
  transform: { title: "التدوير والقلب", tab: "transform", details: ["transform-panel"] },
  enhance: { title: "تحسين الصور", tab: "enhance", details: [] },
  background: { title: "إزالة خلفية الصور", tab: "background", details: [] }
};
const requestedTool = new URLSearchParams(location.search).get("tool");
const selectedTool = toolModes[requestedTool];
if (selectedTool) {
  document.title = selectedTool.title + " | محوّل الملفات";
  const heading = document.querySelector(".editor-page-title");
  if (heading) { heading.textContent = selectedTool.title; heading.classList.remove("visually-hidden"); }
  editorTabs.forEach(tab => { tab.hidden = tab.dataset.editorTab !== selectedTool.tab; });
  editorPanels.forEach(panel => {
    panel.hidden = panel.dataset.editorPanel !== selectedTool.tab;
  });
  detailPanels.forEach(panel => {
    const panelId = panel.id || (panel.querySelector("summary")?.textContent.includes("الأبعاد") ? "resize-panel" :
      panel.querySelector("summary")?.textContent.includes("التدوير") ? "transform-panel" : "");
    panel.hidden = !selectedTool.details.includes(panelId);
  });
  activateEditorTab(selectedTool.tab);
  document.querySelector(".editor-tabs")?.setAttribute("aria-label", selectedTool.title);
} else {
  detailPanels.forEach(panel => { panel.hidden = false; });
}
const fileInput = document.querySelector("#image-file");
const formatInput = document.querySelector("#format");
const qualityInput = document.querySelector("#quality");
const qualityValue = document.querySelector("#quality-value");
const convertButton = document.querySelector("#convert");
const status = document.querySelector("#status");
const sourceInfo = document.querySelector("#source-info");
const removeSelectedButton = document.querySelector("#remove-selected");
const previewWrap = document.querySelector("#preview-wrap");
const preview = document.querySelector("#preview");
const result = document.querySelector("#result");
const resultPreview = document.querySelector("#result-preview");
const resultInfo = document.querySelector("#result-info");
const targetWarning = document.querySelector("#target-warning");
const download = document.querySelector("#download");
const widthInput = document.querySelector("#width");
const heightInput = document.querySelector("#height");
const keepRatio = document.querySelector("#keep-ratio");
const fitMode = document.querySelector("#fit-mode");
const backgroundInput = document.querySelector("#background");
const backgroundMode = document.querySelector("#background-mode");
const cropX = document.querySelector("#crop-x");
const cropY = document.querySelector("#crop-y");
const cropWidth = document.querySelector("#crop-width");
const cropHeight = document.querySelector("#crop-height");
const useCropButton = document.querySelector("#use-crop");
const resetCropButton = document.querySelector("#reset-crop");
const cropInfo = document.querySelector("#crop-info");
const cropPreviewWrap = document.querySelector("#crop-preview-wrap");
const cropPreview = document.querySelector("#crop-preview");
const cropOverlay = document.querySelector("#crop-overlay");
const cropSelection = document.querySelector("#crop-selection");
const uploadZone = document.querySelector("#upload-zone");
const batchPanel = document.querySelector("#batch-panel");
const batchCount = document.querySelector("#batch-count");
const batchConvertButton = document.querySelector("#batch-convert");
const batchFileList = document.querySelector("#batch-file-list");
const batchStatus = document.querySelector("#batch-status");
const batchResults = document.querySelector("#batch-results");
let queuedFiles = [];
let batchResultUrls = [];
let batchThumbUrls = [];
let isBatchProcessing = false;
const targetEnabled = document.querySelector("#target-enabled");
const targetKb = document.querySelector("#target-kb");
const rotateLeft = document.querySelector("#rotate-left");
const updatePreviewTransform = () => { preview.style.transform = "rotate(" + rotation + "deg) scale(" + (flipX ? "-1" : "1") + ", " + (flipY ? "-1" : "1") + ")"; preview.style.transformOrigin = "center"; };
const swapOutputDimensionsForRotation = () => {
  if (!keepRatio.checked) return;
  const oldWidth = widthInput.value;
  widthInput.value = heightInput.value;
  heightInput.value = oldWidth;
};
const rotateRight = document.querySelector("#rotate-right");
const flipHorizontal = document.querySelector("#flip-horizontal");
const flipVertical = document.querySelector("#flip-vertical");
const removeBackgroundButton = document.querySelector("#remove-background");
const restoreOriginalButton = document.querySelector("#restore-original");
const backgroundStatus = document.querySelector("#background-status");
const matteStrengthInput = document.querySelector("#matte-strength");
const matteStrengthValue = document.querySelector("#matte-strength-value");
const enhanceBrightness = document.querySelector("#enhance-brightness");
const enhanceContrast = document.querySelector("#enhance-contrast");
const enhanceSaturation = document.querySelector("#enhance-saturation");
const enhanceBrightnessValue = document.querySelector("#enhance-brightness-value");
const enhanceContrastValue = document.querySelector("#enhance-contrast-value");
const enhanceSaturationValue = document.querySelector("#enhance-saturation-value");
const enhanceReset = document.querySelector("#enhance-reset");
const enhanceAuto = document.querySelector("#enhance-auto");
const enhanceStatus = document.querySelector("#enhance-status");
const getEnhancementFilter = () => `brightness(${Number(enhanceBrightness.value)}%) contrast(${Number(enhanceContrast.value)}%) saturate(${Number(enhanceSaturation.value)}%)`;
const updateEnhancementPreview = () => {
  const filter = getEnhancementFilter();
  preview.style.filter = filter;
  enhanceBrightnessValue.value = Number(enhanceBrightness.value) + "%";
  enhanceContrastValue.value = Number(enhanceContrast.value) + "%";
  enhanceSaturationValue.value = Number(enhanceSaturation.value) + "%";
  const changed = Number(enhanceBrightness.value) !== 100 || Number(enhanceContrast.value) !== 100 || Number(enhanceSaturation.value) !== 100;
  enhanceStatus.textContent = changed ? "تظهر المعاينة بالتعديلات الحالية؛ ستُطبّق على الملف عند التحويل." : "الإعدادات الأصلية دون تغيير.";
};
[enhanceBrightness, enhanceContrast, enhanceSaturation].forEach(input => input.addEventListener("input", updateEnhancementPreview));
enhanceReset.addEventListener("click", () => { enhanceBrightness.value = "100"; enhanceContrast.value = "100"; enhanceSaturation.value = "100"; updateEnhancementPreview(); });
enhanceAuto.addEventListener("click", () => { enhanceBrightness.value = "105"; enhanceContrast.value = "108"; enhanceSaturation.value = "108"; updateEnhancementPreview(); enhanceStatus.textContent = "طُبّق إعداد متوازن مبدئي؛ راجع الصورة فقد لا يناسب جميع الصور."; });
let backgroundCutoutBlob = null;
let sourceUrl = null;
let originalSourceUrl = null;
let resultUrl = null;
let backgroundPipelinePromise = null;
let backgroundRemovalBusy = false;
let selectedFile = null;
let cropEnabled = false;
let rotation = 0;
let flipX = false;
let flipY = false;
let sourceDimensions = { width: 0, height: 0 };
const labels = { "image/png": "PNG", "image/jpeg": "JPEG", "image/webp": "WebP", "image/bmp": "BMP" };
const ext = { "image/png": "png", "image/jpeg": "jpg", "image/webp": "webp", "image/bmp": "bmp" };
const allowedInputTypes = new Set(["image/png", "image/jpeg", "image/webp", "image/gif", "image/bmp", "image/avif"]);
