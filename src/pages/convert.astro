const canvasToBlob = (canvas, mime, quality) => {
  if (mime === "image/bmp") {
    const context = canvas.getContext("2d", { willReadFrequently: true });
    if (!context) return Promise.reject(new Error("تعذر قراءة الصورة لإنشاء ملف BMP."));
    const width = canvas.width, height = canvas.height;
    const pixels = context.getImageData(0, 0, width, height).data;
    const rowSize = Math.floor((width * 3 + 3) / 4) * 4;
    const fileSize = 54 + rowSize * height;
    const buffer = new ArrayBuffer(fileSize);
    const view = new DataView(buffer);
    view.setUint8(0, 0x42); view.setUint8(1, 0x4d);
    view.setUint32(2, fileSize, true); view.setUint32(10, 54, true);
    view.setUint32(14, 40, true); view.setInt32(18, width, true); view.setInt32(22, height, true);
    view.setUint16(26, 1, true); view.setUint16(28, 24, true); view.setUint32(34, rowSize * height, true);
    view.setInt32(38, 2835, true); view.setInt32(42, 2835, true);
    for (let y = 0; y < height; y++) {
      const row = 54 + (height - 1 - y) * rowSize;
      for (let x = 0; x < width; x++) {
        const source = (y * width + x) * 4;
        const alpha = pixels[source + 3] / 255;
        const target = row + x * 3;
        view.setUint8(target, Math.round(pixels[source + 2] * alpha + 255 * (1 - alpha)));
        view.setUint8(target + 1, Math.round(pixels[source + 1] * alpha + 255 * (1 - alpha)));
        view.setUint8(target + 2, Math.round(pixels[source] * alpha + 255 * (1 - alpha)));
      }
    }
    return Promise.resolve(new Blob([buffer], { type: "image/bmp" }));
  }
  return new Promise((resolve, reject) => canvas.toBlob(blob => blob ? resolve(blob) : reject(new Error("لم يتمكن المتصفح من إنشاء ملف الإخراج.")), mime, quality));
};
const encodeWithTarget = async (canvas, mime, requestedQuality, targetBytes) => {
  if (mime === "image/png" || mime === "image/bmp") {
    const blob = await canvasToBlob(canvas, mime);
    return { blob, quality: null, metTarget: blob.size <= targetBytes };
  }
  let low = 0.1, high = requestedQuality, best = null;
  const first = await canvasToBlob(canvas, mime, high);
  if (first.size <= targetBytes) return { blob: first, quality: high, metTarget: true };
  const lowest = await canvasToBlob(canvas, mime, low);
  if (lowest.size > targetBytes) return { blob: lowest, quality: low, metTarget: false };
  best = lowest;
  for (let i = 0; i < 8; i++) {
    const mid = (low + high) / 2;
    const blob = await canvasToBlob(canvas, mime, mid);
    if (blob.size <= targetBytes) { best = blob; low = mid; } else high = mid;
  }
  return { blob: best, quality: low, metTarget: true };
};
convertButton.addEventListener("click", async () => {
  if (!selectedFile || convertButton.disabled) return;
