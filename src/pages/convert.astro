.batch-panel{margin:12px 0;padding:14px;border-radius:13px}
.batch-file-list{gap:5px;margin:10px 0}.batch-file-list li{padding:8px 10px;gap:9px}
.background-summary{gap:11px;padding:12px;border-radius:12px}
@media(max-width:720px){.editor-hero{padding-bottom:10px}.upload-zone{padding:15px;gap:10px}.preview-stage{height:260px;min-height:220px;padding:10px}.preview-stage #preview{max-height:220px}.editor-tabs{gap:6px;margin:12px 0 8px}.editor-tab{min-height:44px;padding:9px 6px;font-size:.9rem}.tool-panel{padding:13px}.button-row .button{flex:1 1 44%}}
@media(max-width:420px){.editor-hero h1{font-size:1.75rem}.upload-copy{flex-basis:140px}.upload-button{width:100%}.preview-stage{height:230px;min-height:200px}.editor-tab{font-size:.84rem}.result{padding:13px}}


/* Calm-green reference tokens applied consistently; no content or behavior changes */
.editor-hero h1 span{color:#167a54}
.privacy-notice{background:#edf6ef;border-color:#cfe5d5}
.privacy-notice>span:first-child{background:#e0f1e5;color:#167a54}
.privacy-notice strong{color:#285c40}
.upload-zone{border-color:#c2dcc9;background:#f7faf7}
.upload-zone.drag-over{border-color:#167a54;background:#edf6ef}
.upload-symbol{background:#e0f1e5;color:#167a54}
.preview-stage{background:#f1f6f1;border-color:#d8e7dc}
.crop-selection{box-shadow:0 0 0 9999px #183b2d40,inset 0 0 0 1px #167a54}
.crop-handle{border-color:#167a54}
.editor-tab{border-color:#d8e7dc;background:#fffefa;color:#42634f;border-radius:9px}
.editor-tab.active{background:#167a54;border-color:#167a54;color:#fff;box-shadow:0 5px 12px #167a5420}
.editor-tab:hover:not(.active){background:#edf5ef;border-color:#b8d8c2}
.result{border-color:#cfe4d5;background:#f1f7f1}
.help-details{border-color:#d8e7dc;background:#f9fcf9}
.help-details summary{color:#315a45}
.batch-panel{border-color:#d8e7dc;background:#f1f7f1}
.batch-file-item[data-state="running"] .queue-status{color:#167a54}
.batch-file-item[data-state="completed"] .queue-status{color:#167a54}
.queue-action:focus-visible,.category-filter:focus-visible{outline-color:#6eaa86}
.batch-result-link{background:#e0f1e5;color:#166a49}
.batch-result-link:hover{background:#cfe8d6}
.upload-zone:focus-within{border-color:#167a54}
.button,.button.primary,#convert{background:#167a54;border-color:#167a54;color:#fff}
.button:hover,.button.primary:hover,#convert:hover{background:#116442;border-color:#116442}
.button.secondary,.button-row .button.secondary{background:#fffefa;border-color:#d8e7dc;color:#315a45}
.button.secondary:hover,.button-row .button.secondary:hover{background:#edf5ef}
input,select,textarea{border-color:#d8e7dc}
input:hover,select:hover,textarea:hover{border-color:#b8d8c2}
input:focus,select:focus,textarea:focus{border-color:#6eaa86;box-shadow:0 0 0 3px #167a5417}
input[type=checkbox],input[type=radio],input[type=range]{accent-color:#167a54}
:focus-visible{outline-color:#6eaa86}
.result h2,.tool-panel summary{color:#315a45}
.background-summary{background:#f7faf7;border-color:#d8e7dc}


/* Much smaller image preview area; keep the image proportional and editing controls intact */
.preview-stage{height:220px;min-height:180px;padding:10px}
.preview-stage #preview{max-width:72%;max-height:175px}
@media(max-width:720px){.preview-stage{height:190px;min-height:170px;padding:8px}.preview-stage #preview{max-width:82%;max-height:145px}}
@media(max-width:420px){.preview-stage{height:170px;min-height:150px}.preview-stage #preview{max-height:125px}}

</style>
<script src="../scripts/background-removal.js"></script>
</BaseLayout>
